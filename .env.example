# ---------------------------------------------------------------------------
# Renovo configuration. Copy to `.env` and edit. Never commit `.env`.
# ---------------------------------------------------------------------------

APP_ENV=production
APP_DEBUG=false
APP_NAME="Renovo"
# Absolute base URL of this instance. Used to build links in emails.
APP_URL=http://localhost:9090

# Host port the web server is published on. Change it if 9090 is taken, and
# keep APP_URL in step.
APP_PORT=9090

# The language and formatting an account gets before it has chosen its own,
# and the one anonymous pages fall back to when a browser asks for something
# this instance has no catalogue for. Any ICU locale: en_GB, en_US, fr_FR…
# The catalogues that exist are the files in translations/.
APP_LOCALE=en_GB

# ---------------------------------------------------------------------------
# Database. Local development uses the SAME engine as production. No SQLite.
# DB_DRIVER: pgsql | mysql
# ---------------------------------------------------------------------------
DB_DRIVER=pgsql
# Host-side value, used by phinx/phpunit/psql when you run them on your machine.
# The containers get DB_HOST=database from docker-compose.yml regardless.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=renovo
DB_USER=renovo
DB_PASSWORD=change-me
DB_CHARSET=utf8

# Host port the database is published on, bound to loopback only. This is for
# tools you run on your own machine (phinx, phpunit, psql); the containers
# always reach the database at the internal hostname regardless.
#
# Left unset on purpose: it then follows the engine in use (5432 for
# PostgreSQL, 3306 for MySQL). Set it only to move the database off a port
# something else already holds.
#DB_PORT_PUBLISHED=5432

# Only used by the MySQL compose variant, for its healthcheck and for creating
# the test database.
DB_ROOT_PASSWORD=renovo-root

# ---------------------------------------------------------------------------
# Sessions. SESSION_KEY must be a long random string; rotating it logs
# everybody out. Generate one with: openssl rand -hex 32
# Set SECRETS_KEY below too: until you do, stored secrets are encrypted under
# SESSION_KEY, and rotating it would make them unreadable.
# ---------------------------------------------------------------------------
SESSION_KEY=
SESSION_NAME=renovo_session
SESSION_LIFETIME_SECONDS=1209600
# For a sign-in with "Keep me signed in" unticked: the cookie ends with the
# browser, and the server forgets the session after this long unused.
SESSION_BROWSER_LIFETIME_SECONDS=43200
# Set to false only when serving over plain HTTP on a trusted network.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# Strict-Transport-Security. Off by default: turn it on only once this instance
# is served over https for good, because a browser that has seen it refuses
# plain http to this name for a year. Sent only when APP_URL is https.
HSTS_ENABLED=false
# Also covers every subdomain of APP_URL's host. Only if all of them are https.
HSTS_INCLUDE_SUBDOMAINS=false

# ---------------------------------------------------------------------------
# Outbound mail (SMTP). Symfony Mailer DSN is derived from these.
# ---------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# tls | ssl | none
SMTP_ENCRYPTION=none
# Whether the relay's certificate is checked, for every encryption setting. On
# unless you say otherwise; set false only for a relay you trust on your own
# network that has a self-signed certificate. The bundled Mailpit in the
# development compose file sets it false for you.
#MAIL_VERIFY_PEER=true
MAIL_FROM_ADDRESS=renovo@localhost
MAIL_FROM_NAME="Renovo"

# Host port for the development mail catcher's web interface.
MAILPIT_PORT=8025

# ---------------------------------------------------------------------------
# Shared outbound HTTP client. Every external call goes through it.
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=10
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_MAX_RESPONSE_BYTES=2097152
HTTP_MAX_REDIRECTS=3
HTTP_USER_AGENT="Renovo"
# Standard proxy variables are honoured if set, in either case (http_proxy
# works too). Renovo always tells curl which proxy to use, so one in the
# environment can never bypass the address check.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# What that client may reach at all (Phase 43):
#   open       any public host, and a private one only if it is a trusted host
#   allowlist  only trusted hosts, the configured exchange-rate provider, and
#              GitHub while update checks are on
#   off        nothing leaves the server over HTTP
# Email (SMTP) is not governed by this. Anything else is treated as off.
#OUTBOUND_HTTP=open

# ---------------------------------------------------------------------------
# Exchange rates. The provider itself is chosen in the first-run wizard or in
# instance settings; these control caching and the (optional) key.
# ---------------------------------------------------------------------------
# How long a cached rate table stays current. Twelve hours by default — the
# free feeds publish once a working day.
EXCHANGE_RATE_TTL_SECONDS=43200
# Minimum gap between refresh attempts, so a provider outage does not mean a
# failed network call on every page view.
EXCHANGE_RATE_RETRY_SECONDS=3600
# Only needed by providers that require one (exchangerate.host, Fixer). Set it
# here to keep the key out of the database entirely; it takes precedence over
# anything entered in the wizard or settings page.
EXCHANGE_RATE_API_KEY=

# ---------------------------------------------------------------------------
# Update checks. Off until an instance administrator turns them on in
# Settings → Instance; once on, Renovo asks GitHub for its latest release once
# a day and tells instance administrators when a newer one is out. GitHub sees
# the server's IP address and nothing else.
# ---------------------------------------------------------------------------
# Set to false to turn the check off for this server whatever the setting says
# — for an instance with no route out, or one whose updates are managed
# elsewhere.
#UPDATE_CHECK=true
# The owner/name whose releases are checked. A fork can point at its own.
#UPDATE_CHECK_REPOSITORY=gwpreston16/Renovo

# ---------------------------------------------------------------------------
# Notifications
#
# Channels themselves are configured per user in the application, not here: a
# Gotify token belongs to a person, and an environment variable belongs to the
# instance. What lives here are the limits the operator owns.
#
# Which destinations a notification may be sent to is *not* configurable by
# environment variable. Private, loopback and link-local addresses are refused
# outright, and the only way to permit one is the trusted-host list under
# Settings, which an instance administrator edits and every use of which is
# logged. That is deliberate: a self-hosted box's network exceptions should be
# visible in the application, not buried in a deployment file.
# ---------------------------------------------------------------------------
# How many times a failed delivery is retried before that occurrence is given
# up on. Covers a relay that is briefly down without hammering a dead endpoint.
NOTIFY_MAX_ATTEMPTS=3
# The outbound ceiling. Not a user preference — it is what stops a bug in an
# alert rule turning the instance into a traffic source.
NOTIFY_MAX_PER_USER_PER_HOUR=60
NOTIFY_MAX_PER_SUBJECT_PER_DAY=20
# How long the idempotency ledger is kept. It only has to outlive the
# occurrences it suppresses; `maintenance:prune` deletes anything older.
NOTIFY_LOG_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# Authentication throttling. Windows are in seconds.
# ---------------------------------------------------------------------------
AUTH_MAX_ATTEMPTS_PER_ACCOUNT=5
AUTH_MAX_ATTEMPTS_PER_IP=20
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------
# API tokens and /api/v1 rate limits.
#
# API_TOKEN_MAX_DAYS caps how long a newly issued or reissued token may last;
# blank or 0 for no maximum. Tokens issued before it is set keep their expiry,
# and the calendar feed's token is exempt. The limits are requests per minute:
# per token, and per client address for requests with no valid token. Ten
# failed tokens from one address in five minutes block it for the rest of the
# five minutes. The address is REMOTE_ADDR, as for the sign-in throttle.
# ---------------------------------------------------------------------------
API_TOKEN_MAX_DAYS=
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_PER_IP_PER_MINUTE=30

# ---------------------------------------------------------------------------
# Stored secrets: two-factor seeds, notification channel settings (bot tokens,
# webhook URLs) and the exchange-rate API key are encrypted at rest under
# SECRETS_KEY (openssl rand -hex 32). Recommended. Blank falls back to
# TOTP_ENCRYPTION_KEY, then SESSION_KEY.
#
# To replace the key: move the current one into SECRETS_PREVIOUS_KEYS
# (comma-separated, decryption only), set the new one, restart, and run
# `php bin/console secrets:rotate`. See docs/operations.md. Back up first.
# ---------------------------------------------------------------------------
SECRETS_KEY=
SECRETS_PREVIOUS_KEYS=

# ---------------------------------------------------------------------------
# Instance backups: the whole database and every stored file, taken on the
# schedule set in Settings → Instance, always encrypted under this key and
# checked after they are written. Unset, instance backups are unavailable.
#
# Generate one with: openssl rand -hex 32
#
# Renovo never stores this key. Keep a copy somewhere that is NOT this server,
# with SESSION_KEY, SECRETS_KEY (and SECRETS_PREVIOUS_KEYS) and
# TOTP_ENCRYPTION_KEY: a backup needs this key to open, and the restored
# instance needs the others to read its two-factor seeds and channel settings.
# ---------------------------------------------------------------------------
BACKUP_ENCRYPTION_KEY=
# Where the encrypted backups are kept. On the appvar volume by default
# (var/backups), which the app and the scheduler share. They are on the same
# server as your data: add a destination in Settings → Instance → Destinations to
# send each one off it as well.
#BACKUP_DIRECTORY=/var/www/html/var/backups
# How long sending one backup to a destination, or fetching one back, may take.
#BACKUP_TRANSFER_TIMEOUT_SECONDS=1800
# An EMPTY database that restore rehearsals restore into and drop again —
# never the application's own (it is refused). Without a name, a rehearsal
# downloads and verifies a copy without restoring it. docker-compose.yml has a
# commented-out rehearsal-db service for this.
#BACKUP_REHEARSAL_DB_DRIVER=pgsql
#BACKUP_REHEARSAL_DB_HOST=rehearsal-db
#BACKUP_REHEARSAL_DB_PORT=5432
#BACKUP_REHEARSAL_DB_NAME=rehearsal
#BACKUP_REHEARSAL_DB_USER=rehearsal
#BACKUP_REHEARSAL_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Two-factor and passkeys.
#
# TOTP_ENCRYPTION_KEY is superseded by SECRETS_KEY. It still works as the key
# when SECRETS_KEY is unset, and is always tried when reading, so an instance
# that set it loses nothing by moving to SECRETS_KEY.
#
# Passkeys are bound to APP_URL's host, which is the relying-party id. Changing
# the host invalidates every registered passkey, by design.
# ---------------------------------------------------------------------------
TOTP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Audit log. How long security events are kept before `maintenance:prune`
# removes them.
# ---------------------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_MAX_LOGO_BYTES=1048576

# Icons fetched from subscriptions' own websites, cached one file per domain
# so that twenty households with the same service cost one request between
# them. Under var/, because nothing serves these directly — each subscription
# gets its own copy in the public logo directory.
#LOGO_CACHE_DIRECTORY=/var/www/html/var/logo-cache

# Invoices and receipts attached to a subscription. Unlike logos these are NOT
# under public/: an invoice has an address and a card number on it, so the files
# are stored outside the web root and are only ever readable through the
# permission-scoped download route.
#
# The default lives under var/, which docker-compose already keeps on the
# `appvar` volume — so it survives a rebuild, and it is a directory your backups
# need to include.
#ATTACHMENT_DIRECTORY=/var/www/html/var/attachments
UPLOAD_MAX_ATTACHMENT_BYTES=10485760

# Members' pictures. Outside the web root for the same reason attachments are,
# and a stronger one: on a family instance these are photographs of children.
# They are readable only through a route that checks you share a household with
# the person in the picture.
#
# The ceiling is on what will be *decoded*, not on what is kept: every upload is
# re-encoded to a small square PNG, which is also what strips the EXIF a phone
# photograph carries. On the same `appvar` volume, so back it up with the rest.
#AVATAR_DIRECTORY=/var/www/html/var/avatars
UPLOAD_MAX_AVATAR_BYTES=2097152

# ---------------------------------------------------------------------------
# Metrics
#
# Unset, and /metrics does not exist: an endpoint carrying counts of accounts
# and subscriptions is not something to expose by accident. Set a long random
# value and give the same one to the scrape job as a bearer token:
#
#   scrape_configs:
#     - job_name: renovo
#       authorization: { credentials: "<the same value>" }
#       static_configs: [{ targets: ["renovo:8080"] }]
#
# An instance administrator can always read /metrics in a browser, token or
# not. Turning this on also starts counting requests by status class, which is
# one small UPDATE per request; leave it unset if nothing scrapes this
# instance.
# ---------------------------------------------------------------------------
#METRICS_TOKEN=
