{% extends 'layout.twig' %}

{% block title %}{{ t('import_preview.title') }} — {{ instance_name }}{% endblock %}

{% block heading %}{{ t('action.preview') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.import_preview') }}{% endblock %}

{% block content %}
    <p class="muted">
        <strong>{{ filename }}</strong> —
        {{ t('import_preview.summary', {'valid': valid_count}) }}
        {%- if invalid_count %} {{ t('import_preview.skipped', {'invalid': invalid_count}) }}{% endif %}
    </p>

    {% if invalid_count %}
        <div class="callout callout-warning">
            {{ t('import_preview.intro') }}
        </div>
    {% endif %}

    <section class="card">
        <div class="table-wrap">
            <table class="table">
                <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">{{ t('field.name') }}</th>
                    <th scope="col">{{ t('field.price') }}</th>
                    <th scope="col">{{ t('field.cycle') }}</th>
                    <th scope="col">{{ t('field.next_payment') }}</th>
                    <th scope="col">{{ t('field.category') }}</th>
                    <th scope="col">{{ t('import_preview.problem') }}</th>
                </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    <tr class="{{ row.errors is not empty ? 'row-invalid' : '' }}">
                        <td class="muted">{{ row.row }}</td>
                        <td>{{ row.input.name }}</td>
                        <td class="num">{{ row.input.price }} {{ row.input.currency }}</td>
                        <td>{{ cycle_label(row.input.billing_cycle, row.input.cycle_days ?: null, row.input.cycle_interval ?: null) }}</td>
                        <td class="num">{{ row.input.next_payment_date ?: t('common.none_symbol') }}</td>
                        <td>{{ row.category ?: t('common.none_symbol') }}</td>
                        <td>
                            {%- if row.errors is empty -%}
                                <span class="pill pill-success">{{ t('import_preview.ready') }}</span>
                            {%- else -%}
                                {% for error in row.errors %}{{ error_message(error) }} {% endfor %}
                            {%- endif -%}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <div class="form-actions">
        <form method="post" action="/import/commit" class="inline">
            {{ csrf_field() }}
            <button type="submit" class="button button-primary" {{ valid_count == 0 ? 'disabled' : '' }}>
                {{ t('import_preview.commit', {'count': valid_count}) }}
            </button>
        </form>

        <a href="/import/map" class="button">{{ t('import_preview.back_to_mapping') }}</a>

        <form method="post" action="/import/cancel" class="inline">
            {{ csrf_field() }}
            <button type="submit" class="button button-quiet">{{ t('action.cancel') }}</button>
        </form>
    </div>
{% endblock %}
