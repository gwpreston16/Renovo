{% extends 'layout.twig' %}

{% import 'partials/payment_method.twig' as payment_method %}
{% import 'subscriptions/_promo.twig' as promo %}

{% block title %}{{ subscription.name }} — {{ t('subscriptions_money.title') }} — {{ instance_name }}{% endblock %}

{% block heading %}{{ subscription.name }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.money') }}{% endblock %}

{% block page_actions %}
    {% if can_plan %}
        <a class="button button-quiet"
           href="/forecast/scenario?cancel[]={{ subscription.id }}">{{ t('subscriptions_money.what_if_cancelled') }}</a>
    {% endif %}
    {% if can(scope, 'subscription.update') and can_edit_row(scope, subscription) %}
        <a class="button button-quiet"
           href="/subscriptions/{{ subscription.id }}/edit">{{ t('subscriptions_form.edit_title') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    {% include 'partials/errors.twig' %}

    {% if subscription.paymentMethodName %}
        <p class="muted">
            <span class="visually-hidden">{{ t('field.payment_method') }}</span>
            {{ payment_method.for_subscription(subscription) }}
        </p>
    {% endif %}

    {#
        What this row's offers took off the normal price, charge by charge in
        the Payments card below; drawn only when it is something.
    #}
    {% if offer_savings is not empty %}
        <p class="savings-line">
            {{ icon('savings') }}
            {{ t('savings.saved_on_row') }}
            <strong class="num">{{ offer_savings|map(total => total.amount_minor|money(total.currency))|join(' · ') }}</strong>
        </p>
    {% endif %}

    {% if promotion %}
        <section class="card callout" id="promotion">
            <h2>{{ t('promo.heading') }} {{ promo.chip(promotion) }}</h2>
            <p>
                {{ t('promo.on_price') }}
                <strong class="num">{{ promotion.change.price.amountMinor|money(promotion.change.price.currency) }}</strong>.
            </p>
            {% if promotion.ends_on and promotion.then %}
                <p>
                    {{ t('promo.then', {'date': promotion.ends_on|local_date('d MMM y')}) }}
                    <strong class="num">{{ promotion.then.amountMinor|money(promotion.then.currency) }}</strong>.
                </p>
            {% else %}
                <p class="muted">{{ t('promo.no_end') }}</p>
            {% endif %}
        </section>
    {% endif %}

    {% if subscription.isTrial and subscription.trialEndDate %}
        <section class="card callout">
            <h2>{{ t('subscriptions_form.free_trial') }}</h2>
            <p>
                {{ t('subscriptions_money.free_until') }} <strong>{{ subscription.trialEndDate|local_date('d MMM y') }}</strong>.
                {{ t('subscriptions_money.trial_end_is_first_charge') }}
            </p>
            <p>
                {{ t('subscriptions_money.it_converts_to') }}
                <strong>{{ subscription.priceAfterConversion.amountMinor|money(
                    subscription.priceAfterConversion.currency) }}</strong>
                {% if subscription.billingCycleAfterConversion %}
                    · {{ cycle_label(subscription.billingCycleAfterConversion.value,
                        subscription.cycleDaysAfterConversion, subscription.cycleIntervalAfterConversion) }}
                {% endif %}
            </p>
        </section>
    {% endif %}

    {#
        The read-only view of a subscription's costs — what the list opens for a
        row the member cannot change. Scheduling a price, the split and the
        attachments are edited on the edit form; usage is recorded here.
    #}
    <div class="columns">
        {% include 'subscriptions/_price_history.twig' with {'editable': false} %}

        <section class="card">
            <h2>{{ t('subscriptions_money.shared_cost') }}</h2>

            {% if shares is empty %}
                <p class="muted">{{ t('subscriptions_money.not_split_owner', {
                    'owner': subscription.ownerName ?? t('subscriptions_money.its_owner'),
                }) }}</p>
            {% else %}
                <div class="table-scroll">
                    <table class="table">
                        <thead>
                        <tr>
                            <th scope="col">{{ t('field.member') }}</th>
                            <th scope="col" class="numeric">{{ t('field.share') }}</th>
                            <th scope="col" class="numeric">{{ t('field.amount') }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for share in shares %}
                            <tr>
                                <td>{{ share.user_name ?? '—' }}</td>
                                <td class="numeric num">{{ share.share_units }}</td>
                                <td class="numeric num">{{ share.amount.amountMinor|money(share.amount.currency) }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <p class="hint">{{ t('subscriptions_money.split_note') }}</p>
            {% endif %}

            {#
                The split is changed on the edit form now, saved with the rest
                of the row. This page is the read-only view of it.
            #}
            {% if subscription.isPrivate %}
                {# A private row is paid by one person; a split would show it to others. #}
                <p class="hint" data-split-closed>{{ t('subscriptions_money.private_no_split') }}</p>
            {% elseif can_edit_split and can(scope, 'split.manage') %}
                <p><a href="/subscriptions/{{ subscription.id }}/edit">{{ t('subscriptions_money.change_split') }}</a></p>
            {% elseif subscription.splitMode.isSplit %}
                <p class="muted">{{ t('error.split.owner_only') }}</p>
            {% endif %}
        </section>
    </div>

    <section class="card">
        <h2>{{ t('subscriptions_money.usage') }}</h2>
        <p class="muted">
            {% if subscription.usageCountedSince %}
                {{ t('subscriptions_money.used_since', {
                    'count': subscription.usageCount,
                    'since': subscription.usageCountedSince|local_date('d MMM y'),
                }) }}
            {% else %}
                {{ t('subscriptions_money.used_count', {'count': subscription.usageCount}) }}
            {% endif %}
        </p>

        {% if can(scope, 'usage.record') and can_edit_row(scope, subscription) %}
            <div class="form-actions">
                <form method="post" action="/subscriptions/{{ subscription.id }}/usage" class="inline">
                    {{ csrf_field() }}
                    <button type="submit" class="button button-primary">{{ t('stats.used_it') }}</button>
                </form>

                <form method="post" action="/subscriptions/{{ subscription.id }}/usage/rating" class="inline">
                    {{ csrf_field() }}
                    <label for="rating" class="visually-hidden">{{ t('field.rating') }}</label>
                    <select id="rating" name="rating">
                        <option value="">{{ t('subscriptions_money.no_rating') }}</option>
                        {% for value in 1..max_rating %}
                            <option value="{{ value }}"
                                    {{ subscription.usageRating == value ? 'selected' : '' }}>
                                {{ value }} / {{ max_rating }}
                            </option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="button">{{ t('subscriptions_money.save_rating') }}</button>
                </form>

                <form method="post" action="/subscriptions/{{ subscription.id }}/usage/reset" class="inline"
                      data-confirm="{{ t('confirm.reset_usage') }}">
                    {{ csrf_field() }}
                    <button type="submit" class="button button-quiet">{{ t('subscriptions_money.reset_count') }}</button>
                </form>
            </div>
        {% endif %}
    </section>

    {% include 'subscriptions/_payments.twig' %}

    {% include 'subscriptions/_attachments.twig' with {'editable': false} %}
{% endblock %}
