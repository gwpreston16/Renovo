{#
    The stats strip.

    Active, Trials and Paused are the list's own statuses, so each count is the
    number of rows the status filter of the same name would page through — the
    Active tile leaves out the trials beside it. Per month is the statistics
    service's recurring monthly total, through the same partial the dashboard's
    tiles use: one clean number when there is an honest one to show, subtotals
    with the combined figure when every currency converts, and subtotals alone
    with the missing currency named when one does not.

    Every count is read through the scoping layer, so it counts what its reader
    may see and nothing more.
#}
{% import 'partials/spend.twig' as figure %}

<section class="metric-grid subscription-strip" id="subscription-strip" aria-label="{{ t('subscriptions.strip') }}">
    <article class="card stat metric kpi kpi-side">
        <span class="kpi-icon kpi-icon-ok">{{ icon('ok') }}</span>
        <div class="kpi-body">
            <h2 class="stat-label">{{ t('state.active') }}</h2>
            <p class="stat-value num">{{ strip.active|decimal(0) }}</p>
        </div>
    </article>

    <article class="card stat metric kpi kpi-side">
        <span class="kpi-icon kpi-icon-info">{{ icon('trial') }}</span>
        <div class="kpi-body">
            <h2 class="stat-label">{{ t('subscriptions.trials_heading') }}</h2>
            <p class="stat-value num">{{ strip.trials|decimal(0) }}</p>
        </div>
    </article>

    <article class="card stat metric kpi kpi-side">
        <span class="kpi-icon kpi-icon-warn">{{ icon('paused') }}</span>
        <div class="kpi-body">
            <h2 class="stat-label">{{ t('state.paused') }}</h2>
            <p class="stat-value num">{{ strip.paused|decimal(0) }}</p>
        </div>
    </article>

    <article class="card stat metric kpi kpi-side">
        <span class="kpi-icon kpi-icon-neutral">{{ icon('calculator') }}</span>
        <div class="kpi-body">
            <h2 class="stat-label">{{ t('field.per_month') }}</h2>
            {{ figure.spend(strip.per_month, t('dashboard.per_month_unit')) }}
        </div>
    </article>
</section>
