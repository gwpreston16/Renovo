{% extends 'layout.twig' %}

{% block heading %}{{ t('nav.subscriptions') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.subscriptions') }}{% endblock %}

{% block content %}
    {#
        The screen the design asks for: the four figures, the toolbar, the list
        itself, and the cancel-by deadlines beneath it. The list is the list —
        the same fragment htmx swaps — rather than a second one built for this
        arrangement. Free trials and the category breakdown live on the
        dashboard now, which carries both.
    #}
    {% include 'subscriptions/_strip.twig' %}

    <section class="card subscriptions-toolbar" aria-label="{{ t('subscriptions.toolbar') }}">
        {#
            The search box. A GET form, so without script it is an ordinary
            search that reloads the page; with htmx it replaces only the list and
            pushes the query string, so the view is bookmarkable and the back
            button works. The rest of the filter rides along in the hidden
            fields `_toolbar.twig` keeps current.

            The add button sits beside it but outside the form: it is a link to
            the quick-add dialog, not part of the search.
        #}
        <div class="list-search-bar">
            <form id="list-search" class="list-search" role="search" method="get" action="/subscriptions"
                  data-save-on-change
                  hx-get="/subscriptions"
                  hx-target="#subscription-list" hx-sync="#subscription-list:replace"
                  hx-select="#subscription-list"
                  hx-swap="outerHTML"
                  hx-push-url="true"
                  hx-trigger="keyup changed delay:300ms from:#q, search from:#q, submit">
                <label for="q" class="visually-hidden">{{ t('subscriptions.search') }}</label>
                <span class="list-search-field">
                    {{ icon('search') }}
                    <input type="search" id="q" name="q" value="{{ filter.search }}"
                           placeholder="{{ t('subscriptions.filter_placeholder') }}">
                </span>
                {% include 'subscriptions/_toolbar_search_state.twig' %}
                <noscript><button type="submit" class="button">{{ t('subscriptions.apply_filters') }}</button></noscript>
            </form>

            {% if can(scope, 'subscription.create') %}
                <a class="button button-primary list-search-add" href="/subscriptions/new"
                   data-opens-dialog="quick-add">
                    {{ icon('add') }}<span>{{ t('subscriptions.add_subscription') }}</span>
                </a>
            {% endif %}
        </div>

        {% include 'subscriptions/_toolbar.twig' with {'oob': false} %}
    </section>

    {#
        `oob_query: false` because this page renders the toolbar itself, just
        above, and the fragment's out-of-band copy of it would be a second set
        of elements with the same ids.
    #}
    {% include 'subscriptions/_list.twig' with {'oob_query': false} %}

    {% include 'subscriptions/_cancel_by.twig' %}
{% endblock %}
