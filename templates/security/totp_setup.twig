{% extends 'layout.twig' %}

{% block title %}{{ t('security_totp_setup.title') }} — {{ instance_name }}{% endblock %}

{% block heading %}{{ t('security_totp_setup.heading') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.totp_setup') }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <ol class="stack">
            <li>{{ t('security_totp_setup.scan') }}</li>
            <li>{{ t('security_totp_setup.enter_code') }}</li>
        </ol>

        <div class="qr">{{ qr_code|raw }}</div>

        <p class="muted">
            {{ t('security_totp_setup.setup_key') }} <code>{{ secret }}</code>
        </p>

        <form method="post" action="/profile/two-step/totp/confirm" class="stack">
            {{ csrf_field() }}

            <label for="code">{{ t('security_totp_setup.six_digit_code') }}</label>
            <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code"
                   pattern="[0-9]{6}" maxlength="6" required autofocus
                   {% if errors.code is defined %}aria-invalid="true" aria-describedby="code-error"{% endif %}>
            {% if errors.code is defined %}<p class="field-error" id="code-error">{{ error_message(errors.code) }}</p>{% endif %}

            <button type="submit" class="button button-primary">{{ t('security_totp_setup.confirm') }}</button>
        </form>

        <form method="post" action="/profile/two-step/totp/cancel" class="inline">
            {{ csrf_field() }}
            <button type="submit" class="button button-quiet">{{ t('action.cancel') }}</button>
        </form>
    </section>
{% endblock %}
