{#
    A set of charges' figure, by the per-currency rule, in a line of running
    text: one currency is its amount; several that all convert are the
    combined figure with the subtotals after it; several where one has no rate
    are the subtotals alone, because a total that silently left a currency out
    would be a wrong number rather than an approximate one.

    `figures`  {totals: [{currency, amount_minor}], combined: {currency, amount_minor, unconvertible}},
               and `estimate_currencies`, the currencies holding a bill whose
               amount varies, which are drawn "≈" (`partials/estimate.twig`).
#}
{% macro inline(figures) %}
    {%- import 'partials/estimate.twig' as estimate -%}
    {%- if figures is null or figures.totals is empty -%}
        {{ t('common.none_symbol') }}
    {%- elseif figures.totals|length == 1 -%}
        {{ estimate.mark(figures, figures.totals[0].amount_minor|money(figures.totals[0].currency), figures.totals[0].currency) }}
    {%- elseif figures.combined.amount_minor is not null -%}
        {{ estimate.mark(figures, figures.combined.amount_minor|money(figures.combined.currency)) }}
        <span class="muted">({% for total in figures.totals %}{{ estimate.mark(figures, total.amount_minor|money(total.currency), total.currency) }}{{ not loop.last ? ' · ' : '' }}{% endfor %})</span>
    {%- else -%}
        {% for total in figures.totals %}{{ estimate.mark(figures, total.amount_minor|money(total.currency), total.currency) }}{{ not loop.last ? ' · ' : '' }}{% endfor %}
    {%- endif -%}
{% endmacro %}

{#
    The same rule in a day cell's corner, where there is room for one figure:
    the amount, the combined figure, or the subtotals stacked.
#}
{% macro compact(figures) %}
    {%- import 'partials/estimate.twig' as estimate -%}
    {%- if figures.totals|length == 1 -%}
        {{ estimate.mark(figures, figures.totals[0].amount_minor|money(figures.totals[0].currency), figures.totals[0].currency) }}
    {%- elseif figures.combined.amount_minor is not null -%}
        {{ t('dashboard.approx', {'amount': figures.combined.amount_minor|money(figures.combined.currency)}) }}
    {%- else -%}
        {% for total in figures.totals %}{{ estimate.mark(figures, total.amount_minor|money(total.currency), total.currency) }}{{ not loop.last ? ' ' : '' }}{% endfor %}
    {%- endif -%}
{% endmacro %}
