{% extends 'layout.twig' %}

{% block title %}{{ t('nav.forecast') }} — {{ instance_name }}{% endblock %}

{% block heading %}{{ t('stats.title') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.forecast') }}{% endblock %}

{% block page_actions %}
    {% set toggle_label = mine_only ? t('forecast.show_whole_household') : t('forecast.show_only_my_share') %}
    <a class="button button-quiet" href="/forecast{{ mine_only ? '' : '?mine=1' }}" title="{{ toggle_label }}">
        {{- icon('household') -}}
        <span class="button-label">{{ toggle_label }}</span>
    </a>
{% endblock %}

{% block content %}
    {#
        The second of Analytics' two tabs: what the next twelve months will
        cost. The KPI row; the months as bars, regular charges beneath and lump
        renewals on top; what cancelling would save beside the trials about to
        start costing money; and the price changes already announced. A month's
        charges one by one are the calendar's, which each bar links to.

        Every figure is a sum over the same forecast charges — see
        `ForecastScreenService` — so the cards and the chart agree, and "just
        mine" narrows all of them at once.
    #}
    {% include 'stats/_tabs.twig' with {tab: 'forecast'} only %}

    {% if mine_only %}
        <p class="muted note">{{ t('forecast.mine_note') }}</p>
    {% endif %}

    {% include 'forecast/_kpis.twig' %}

    {% include 'forecast/_chart.twig' %}

    <div class="analytics-pair">
        {% include 'forecast/_if_cancelled.twig' %}
        <div class="analytics-stack">
            {% include 'forecast/_trials.twig' %}
            {% include 'forecast/_price_changes.twig' %}
        </div>
    </div>
{% endblock %}
