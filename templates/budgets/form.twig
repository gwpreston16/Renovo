{#
    The budget form, whole. It is also what the Budgets screen's dialog loads,
    which is why it renders without the surrounding page when htmx asks for
    it: one definition of what a budget needs, New and Edit alike.

    The limit is in the base currency for a new budget; an existing one set in
    another currency keeps it, and the label says which. Whose spending lists
    only what this viewer may choose (BudgetService::subjectOptions()) — the
    server refuses anything else, so a forged value gets an error, not a budget.
#}
{% extends is_htmx ? 'partials/bare.twig' : 'layout.twig' %}

{% set is_edit = budget_id is not null %}

{% block heading %}{{ is_edit ? t('budgets_form.edit_title') : t('budgets.new_budget') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.budget_form') }}{% endblock %}

{% block content %}
    {% include 'partials/errors.twig' %}

    <section class="card narrow budget-form">
        <form method="post" action="{{ is_edit ? '/budgets/' ~ budget_id : '/budgets' }}" class="stack"
              id="budget-form">
            {{ csrf_field() }}

            <div class="field">
                <label for="budget-name">{{ t('field.name') }}</label>
                <input type="text" id="budget-name" name="name" value="{{ values.name|default('') }}" required
                       maxlength="100" placeholder="{{ t('budgets_form.name_placeholder') }}"
                       {% if errors.name is defined %}aria-invalid="true" aria-describedby="budget-name-error"{% endif %}>
                {% if errors.name is defined %}<p class="field-error" id="budget-name-error">{{ error_message(errors.name) }}</p>{% endif %}
            </div>

            <div class="budget-form-row">
                <div class="field">
                    <label for="budget-amount">{{ t('budgets_form.limit_in', {'currency': currency}) }}</label>
                    <input type="text" id="budget-amount" name="amount" inputmode="decimal" class="num"
                           value="{{ values.amount|default('') }}" placeholder="{{ 150|decimal(2) }}" required
                           {% if errors.amount is defined or errors.currency is defined %}aria-invalid="true" aria-describedby="budget-amount-error"{% endif %}>
                    {% if errors.amount is defined %}<p class="field-error" id="budget-amount-error">{{ error_message(errors.amount) }}</p>{% endif %}
                    {% if errors.currency is defined %}<p class="field-error" id="budget-amount-error">{{ error_message(errors.currency) }}</p>{% endif %}
                </div>

                {% set period = values.period|default('monthly') %}
                <div class="field" role="radiogroup" aria-labelledby="budget-period-label"
                     {% if errors.period is defined %}aria-describedby="budget-period-error"{% endif %}>
                    <span class="group-label" id="budget-period-label">{{ t('field.period') }}</span>
                    <div class="segmented">
                        {% for option in periods %}
                            <label class="segmented-option">
                                <input type="radio" name="period" value="{{ option.value }}"
                                       {% if loop.first %}id="budget-period"{% endif %}
                                       {{ period == option.value ? 'checked' : '' }}>
                                <span>{{ budget_period_label(option.value) }}</span>
                            </label>
                        {% endfor %}
                    </div>
                    {% if errors.period is defined %}<p class="field-error" id="budget-period-error">{{ error_message(errors.period) }}</p>{% endif %}
                </div>
            </div>

            <div class="field">
                <label for="budget-category">{{ t('field.category') }}</label>
                <select id="budget-category" name="category_id"
                        {% if errors.category_id is defined %}aria-invalid="true" aria-describedby="budget-category-error"{% endif %}>
                    <option value="">{{ t('budgets.all_categories') }}</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}"
                                {{ values.category_id|default('') == category.id ? 'selected' : '' }}>
                            {{ category.name }}
                        </option>
                    {% endfor %}
                </select>
                {% if errors.category_id is defined %}<p class="field-error" id="budget-category-error">{{ error_message(errors.category_id) }}</p>{% endif %}
            </div>

            {% set subject = values.subject_user_id|default(current_user.id) %}
            {#
                A select falls back to its first option; a radio group does
                not, so a subject that is not among the choices checks the
                first one rather than sending nothing.
            #}
            {% set subject_offered = subjects.household and subject == 'household' %}
            {% for member in subjects.members %}
                {% set subject_offered = subject_offered or subject == member.id %}
            {% endfor %}
            {% if not subject_offered %}
                {% set subject = subjects.household ? 'household' : (subjects.members|first).id|default(null) %}
            {% endif %}
            {% if locked_subject %}
                {# Not a choice this viewer has: shown, and not sent, so an edit keeps it. #}
                <div class="field">
                    <span class="group-label">{{ t('budgets_form.whose_spending') }}</span>
                    <p class="budget-locked-subject" data-locked-subject>
                        {{ locked_subject.household ? t('budgets.household') : locked_subject.name }}
                    </p>
                    <p class="hint">{{ t('budgets_form.subject_locked_hint') }}</p>
                </div>
            {% else %}
                <div class="field" role="radiogroup" aria-labelledby="budget-subject-label"
                     aria-describedby="budget-subject-hint{% if errors.subject_user_id is defined %} budget-subject-error{% endif %}">
                    <span class="group-label" id="budget-subject-label">{{ t('budgets_form.whose_spending') }}</span>
                    <div class="segmented">
                        {% if subjects.household %}
                            <label class="segmented-option">
                                <input type="radio" name="subject_user_id" value="household" id="budget-subject"
                                       {{ subject == 'household' ? 'checked' : '' }}>
                                <span>{{ t('budgets.household') }}</span>
                            </label>
                        {% endif %}
                        {% for member in subjects.members %}
                            <label class="segmented-option">
                                <input type="radio" name="subject_user_id" value="{{ member.id }}"
                                       {% if loop.first and not subjects.household %}id="budget-subject"{% endif %}
                                       {{ subject == member.id ? 'checked' : '' }}>
                                <span>{{ member.display_name }}</span>
                            </label>
                        {% endfor %}
                    </div>
                    <p class="hint" id="budget-subject-hint">{{ t('budgets_form.subject_hint') }}</p>
                    {% if errors.subject_user_id is defined %}
                        <p class="field-error" id="budget-subject-error">{{ error_message(errors.subject_user_id) }}</p>
                    {% endif %}
                </div>
            {% endif %}

            {% set threshold = values.warn_threshold_percent|default(85) %}
            <div class="field">
                <div class="range-label">
                    <label for="budget-warn">{{ t('budgets_form.warn_at') }}</label>
                    <output id="budget-warn-output" for="budget-warn" class="num">{{ t('budgets.percent', {'percent': threshold}) }}</output>
                </div>
                <input type="range" id="budget-warn" name="warn_threshold_percent" class="range-input"
                       min="1" max="100" step="1" value="{{ threshold }}"
                       aria-describedby="budget-warn-hint" data-range-output="budget-warn-output">
                <p class="hint" id="budget-warn-hint">{{ t('budgets_form.threshold_hint') }}</p>
                {% if errors.warn_threshold_percent is defined %}
                    <p class="field-error">{{ error_message(errors.warn_threshold_percent) }}</p>
                {% endif %}
            </div>
        </form>

        {% if is_edit %}
            <form method="post" action="/budgets/{{ budget_id }}/delete" id="budget-delete-form"
                  data-confirm="{{ t('confirm.delete_budget') }}">
                {{ csrf_field() }}
            </form>
        {% endif %}

        <div class="form-actions budget-form-actions">
            {% if is_edit %}
                <button type="submit" form="budget-delete-form" class="button button-danger">
                    {{ icon('delete') }}<span>{{ t('action.delete') }}</span>
                </button>
            {% endif %}
            <a class="button button-quiet" href="/budgets" data-closes-dialog="budget-dialog">{{ t('action.cancel') }}</a>
            <button type="submit" form="budget-form" class="button button-primary">{{ t('budgets_form.save_budget') }}</button>
        </div>
    </section>
{% endblock %}
