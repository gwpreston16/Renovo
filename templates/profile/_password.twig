{#
    The password card.

    Its own file because it is rendered in two arrangements: beside the email
    address for a member using the application normally, and on its own — with
    everything else on the page withheld — for one still on the temporary
    password an Owner gave them. One card, one copy of it.
#}
<section class="card" id="password" aria-labelledby="password-heading">
    <h2 id="password-heading">{{ t('account.your_password') }}</h2>

    <form method="post" action="/profile/password" class="stack">
        {{ csrf_field() }}

        <div class="field">
            <label for="current_password">{{ t('account.current_password') }}</label>
            <input type="password" id="current_password" name="current_password" required
                   autocomplete="current-password">
        </div>

        {# `new_password`, not `password`: the card itself is `#password` (the
           anchor a redirect lands on), and a label's `for` resolves to the
           first element with the id, which would leave this field unnamed. #}
        <div class="field">
            <label for="new_password">{{ t('account.new_password') }}</label>
            <input type="password" id="new_password" name="password" required
                   autocomplete="new-password">
        </div>

        <div class="field">
            <label for="password_confirm">{{ t('account.confirm_password') }}</label>
            <input type="password" id="password_confirm" name="password_confirm" required
                   autocomplete="new-password">
        </div>

        <div class="field">
            <label class="choice" for="sign_out_others">
                <input type="checkbox" id="sign_out_others" name="sign_out_others" value="1" checked>
                <span>{{ t('account.sign_out_others') }}</span>
            </label>
            <p class="hint">{{ t('account.sign_out_others_hint') }}</p>
        </div>

        <div class="form-actions">
            <button type="submit" class="button button-outline">{{ t('account.save_password') }}</button>
        </div>
    </form>
</section>
