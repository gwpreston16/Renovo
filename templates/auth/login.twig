{% extends 'auth/_layout.twig' %}

{#
    Sign in.

    "Welcome back." and nothing more: a signed-out visitor is anonymous, an
    instance may hold several households, and naming one to whoever loads the
    page would be telling them it exists.

    Every failure the password step can report is on the email field, and is
    shown once, above the form, as an alert — a wrong password and an unknown
    address read exactly the same, and so does the lock-out, with its wait.
#}

{% block card_title %}{{ t('auth_login.title') }}{% endblock %}
{% block card_intro %}{{ t('auth_login.welcome_back') }}{% endblock %}

{% block card_body %}
    {% if errors.email is defined %}
        {% include 'auth/_alert.twig' with {'message': error_message(errors.email)} only %}
    {% endif %}

    <form method="post" action="/login" class="auth-form" id="login-form">
        {{ csrf_field() }}
        <input type="hidden" name="next" value="{{ next }}">

        {% include 'auth/_input.twig' with {
            'id': 'email',
            'name': 'email',
            'type': 'email',
            'label': t('field.email'),
            'value': values.email|default(''),
            'autocomplete': 'username',
            'placeholder': t('auth.email_placeholder'),
            'required': true,
            'autofocus': true,
        } only %}

        {% set forgot %}<a class="auth-label-link" href="/forgot-password">{{ t('auth_login.forgot_password') }}</a>{% endset %}
        {% include 'auth/_password.twig' with {
            'id': 'password',
            'name': 'password',
            'label': t('field.password'),
            'autocomplete': 'current-password',
            'aside': forgot,
        } only %}

        {#
            A hidden "0" ahead of the box, so an unticked box still says so; a
            post that names neither keeps the lifetime sessions always had.
        #}
        <input type="hidden" name="remember" value="0">
        <label class="auth-check">
            <input type="checkbox" name="remember" value="1" id="remember"
                   {{ (values.remember|default('1')) != '0' ? 'checked' : '' }}>
            <span>{{ t('auth_login.keep_signed_in') }}</span>
        </label>

        <button type="submit" class="button button-primary auth-submit">{{ t('auth_login.title') }}</button>
    </form>

    {#
        Offered beside the password form rather than behind it: a passkey is a
        way of signing in, not a fallback for one. Rendered hidden and shown by
        webauthn.js only where one can be used — it needs script and a secure
        context, so without either it is never offered.
    #}
    <div class="auth-passkey" id="passkey-block" hidden>
        <p class="auth-divider"><span>{{ t('auth.or') }}</span></p>
        <button type="button" class="button auth-submit" id="passkey-button"
                data-passkey="sign-in" data-reveal="passkey-block" data-error="passkey-error"
                data-options-url="/login/passkey/options"
                data-verify-url="/login/passkey?next={{ next|url_encode }}" data-remember="remember"
                data-csrf="{{ csrf_token() }}">
            {{ icon('key') }}
            <span>{{ t('auth_login.passkey') }}</span>
        </button>
        <p class="field-error" id="passkey-error" role="alert" hidden></p>
    </div>
{% endblock %}

{% block card_after %}
    {% if registration_allowed %}
        <p class="auth-foot">
            {{ t('auth_login.no_account') }}
            <a href="/register">{{ t('auth_register.title') }}</a>
        </p>
    {% endif %}

    <script src="{{ asset('/assets/webauthn.js') }}" defer></script>
{% endblock %}
