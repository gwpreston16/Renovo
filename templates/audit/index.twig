{% extends 'layout.twig' %}

{% block heading %}{{ t('audit.title') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.audit') }}{% endblock %}

{% block content %}
    <p class="muted">
        {{ is_instance_view ? t('audit.scope_instance') : t('audit.scope_household') }}
        {{ t('audit.retention_note') }}
    </p>

    <form method="get" action="/audit" class="filters"
          hx-get="/audit" hx-target="#audit-entries" hx-push-url="true">
        <label for="action">{{ t('field.event') }}</label>
        <select id="action" name="action" data-autosubmit>
            <option value="">{{ t('audit.all_events') }}</option>
            {% for item in actions %}
                <option value="{{ item.value }}" {{ selected_action == item.value ? 'selected' : '' }}>
                    {{ t(item.labelKey()) }}
                </option>
            {% endfor %}
        </select>
        <noscript><button type="submit" class="button">{{ t('audit.filter') }}</button></noscript>
    </form>

    <div id="audit-entries">
        {% include 'audit/_entries.twig' %}
    </div>
{% endblock %}
