{#
    The entries table, rendered on its own for htmx filter and page swaps.
    The status line is what a screen reader hears after a swap: app.js
    clears and refills it so the polite live region announces the new page.
#}
<p class="visually-hidden" role="status" data-swap-status>{{ t('audit_entries.pager', {'page': page, 'pages': max(pages, 1), 'total': total}) }}</p>
<div class="table-scroll">
    <table class="table">
        <thead>
        <tr>
            <th scope="col">{{ t('field.when') }}</th>
            <th scope="col">{{ t('field.event') }}</th>
            <th scope="col">{{ t('field.who') }}</th>
            <th scope="col">{{ t('field.detail') }}</th>
            <th scope="col">{{ t('field.address') }}</th>
        </tr>
        </thead>
        <tbody>
        {% for entry in entries %}
            <tr>
                <td class="num">{{ entry.occurredAt|local_date('d MMM y HH:mm') }}</td>
                {# A failure is findable by eye in a long log: its event is a badge. #}
                <td>
                    {%- if entry.action.isFailure -%}
                        <span class="badge badge-warn">{{ t(entry.action.labelKey()) }}</span>
                    {%- else -%}
                        {{ t(entry.action.labelKey()) }}
                    {%- endif -%}
                </td>
                <td>
                    {{ entry.actorName }}
                    {% if entry.targetLabel and entry.targetUserId != entry.actorUserId %}
                        <span class="muted">→ {{ entry.targetLabel }}</span>
                    {% endif %}
                </td>
                <td class="muted">{{ entry.summary }}</td>
                <td class="muted">{{ entry.ipAddress|default(t('common.none_symbol')) }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="muted">{{ t('audit_entries.no_events_recorded') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% if pages > 1 %}
    <nav class="pagination" aria-label="{{ t('subscriptions_list.pagination') }}">
        {% if page > 1 %}
            <a id="audit-newer" class="button button-quiet"
               href="/audit?page={{ page - 1 }}{{ selected_action ? '&action=' ~ selected_action : '' }}"
               hx-get="/audit?page={{ page - 1 }}{{ selected_action ? '&action=' ~ selected_action : '' }}"
               hx-target="#audit-entries" hx-sync="#audit-entries:replace" hx-push-url="true">{{ t('action.newer') }}</a>
        {% endif %}

        <span class="muted">{{ t('audit_entries.pager', {'page': page, 'pages': pages, 'total': total}) }}</span>

        {% if page < pages %}
            <a id="audit-older" class="button button-quiet"
               href="/audit?page={{ page + 1 }}{{ selected_action ? '&action=' ~ selected_action : '' }}"
               hx-get="/audit?page={{ page + 1 }}{{ selected_action ? '&action=' ~ selected_action : '' }}"
               hx-target="#audit-entries" hx-sync="#audit-entries:replace" hx-push-url="true">{{ t('action.older') }}</a>
        {% endif %}
    </nav>
{% endif %}
