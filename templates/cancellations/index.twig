{% extends 'layout.twig' %}

{% block heading %}{{ t('nav.cancellations') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.cancellations') }}{% endblock %}

{% block content %}
    {% import 'partials/logo.twig' as logo %}

    <p class="muted note">
        {{ t('cancellations.intro') }}
    </p>

    {% if deadlines is empty %}
        <section class="card">
            <p class="muted empty">{{ t('cancellations.empty') }}</p>
        </section>
    {% else %}
        <section class="card">
            <div class="table-scroll">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">{{ t('field.subscription') }}</th>
                        <th scope="col">{{ t('nav.cancellations') }}</th>
                        <th scope="col">{{ t('field.next_charge') }}</th>
                        <th scope="col">{{ t('cancellations.notice') }}</th>
                        <th scope="col" class="numeric">{{ t('field.price') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in deadlines %}
                        <tr class="{{ row.is_passed ? 'is-passed' : (row.is_urgent ? 'is-urgent' : '') }}">
                            <td>
                                <div class="cell-name">
                                    {{ logo.mark(row.subscription) }}
                                    <div>
                                        <a href="/subscriptions/{{ row.subscription.id }}/edit">{{
                                            row.subscription.name }}</a>
                                        {% if row.subscription.categoryName %}
                                            <div class="hint">{{ row.subscription.categoryName }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                            <td>
                                <strong>{{ row.deadline|local_date('d MMM y') }}</strong>
                                <div class="hint">
                                    {% if row.kind == 'contract' %}
                                        {% if row.is_passed %}
                                            <span class="badge badge-warn">{{ t('cancellations.contract_ended') }}</span>
                                            {{ t('cancellations.contract_ended_days', {'days': row.days_remaining * -1}) }}
                                        {% else %}
                                            {{ t('cancellations.contract_ends') }} ·
                                            {{ row.days_remaining == 0 ? t('state.today') : t('cancellations.days_left', {'days': row.days_remaining}) }}
                                        {% endif %}
                                    {% elseif row.is_passed %}
                                        <span class="badge badge-bad">{{ t('cancellations.deadline_passed') }}</span>
                                        {{ t('cancellations.passed_days', {'days': row.days_remaining * -1}) }}
                                    {% elseif row.days_remaining == 0 %}
                                        <span class="badge badge-warn">{{ t('state.today') }}</span>
                                    {% else %}
                                        {{ t('cancellations.days_left', {'days': row.days_remaining}) }}
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                {{ row.subscription.nextChargeDate
                                    ? row.subscription.nextChargeDate|local_date('d MMM y') : '—' }}
                                {% if row.subscription.isTrial %}
                                    <div class="hint">{{ t('state.trial_converts') }}</div>
                                {% endif %}
                            </td>
                            <td>{{ row.kind == 'contract' ? t('common.none_symbol') : notice_label(row.subscription.noticePeriod.amount,
                                row.subscription.noticePeriod.unit) }}</td>
                            <td class="numeric num">{{
                                row.subscription.price.amountMinor|money(row.subscription.price.currency) }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <p class="muted note">
            {{ t('cancellations.note', {'days': urgent_days}) }}
        </p>
    {% endif %}
{% endblock %}
