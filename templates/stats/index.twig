{% extends 'layout.twig' %}

{% block heading %}{{ t('stats.title') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.stats') }}{% endblock %}

{% block content %}
    {#
        Analytics is one rail item covering two screens: this one, which says
        what has happened, and the forecast, which says what is about to. The
        tabs are what keep the forecast one click away; the keyboard's `g f`
        reaches the same page.
    #}
    {% include 'stats/_tabs.twig' with {tab: 'overview'} only %}

    {#
        The prototype's arrangement: the KPI row; twelve months back and twelve
        ahead; this year against last beside who pays and the most expensive;
        the price history beside the insights and the savings. Then what this page has always
        carried: the same cost by period across the full width, and below it
        the two breakdown donuts stacked beside the cost-per-use table with its
        usage form.

        Not one figure here is computed for this screen. See
        `AnalyticsScreenService` for which service each one binds to.
    #}
    {% include 'stats/_kpis.twig' %}

    {% include 'stats/_months.twig' %}

    <div class="analytics-pair">
        {% include 'stats/_year_against_year.twig' %}
        <div class="analytics-stack">
            {#
                The household dashboard's card, with its data scoped the same
                way — only the reader's own share in ISOLATED mode.
            #}
            <div id="analytics-who-pays">
                {% include 'dashboard/cards/household/who_pays.twig' %}
            </div>
            {% include 'stats/_most_expensive.twig' %}
        </div>
    </div>

    <div class="analytics-pair">
        {% include 'stats/_price_history.twig' %}
        <div class="analytics-stack">
            {% include 'stats/_insights.twig' %}
            {% include 'stats/_savings.twig' %}
        </div>
    </div>

    <h2 class="section-heading">{{ t('stats.breakdown') }}</h2>

    <div class="analytics-per-period">
        <section class="card">
            <h2>{{ t('stats.per_period') }}</h2>

            <div class="stat-grid stat-grid-inline">
                {% for label, amount in per_period %}
                    <div class="stat">
                        <h3 class="stat-label">{{ t('period.per_' ~ label) }}</h3>
                        <p class="stat-value num">
                            {{ amount is not null ? amount|money(combined_yearly.currency) : t('common.none_symbol') }}
                        </p>
                    </div>
                {% endfor %}
            </div>

            {% if combined_yearly.amount_minor is null %}
                <p class="muted note">
                    {{ t('stats.unconvertible', {
                        'currency': base_currency,
                        'currencies': combined_yearly.unconvertible|join(', '),
                    }) }}
                </p>
                <h3 class="stat-label">{{ t('stats.per_year_heading') }}</h3>
                <ul class="plain">
                    {% for total in yearly_by_currency %}
                        <li>{{ total.amount_minor|money(total.currency) }}</li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="hint">{{ t('stats.per_year_note') }}</p>
            {% endif %}
        </section>
    </div>

    <div class="analytics-review">
        <div class="analytics-breakdown">
            {% include 'stats/_categories.twig' %}
            {% include 'stats/_payment_methods.twig' %}
        </div>

        {#
            "Worth it?" is a column of its own, not a card at the foot of the
            page: it is a row per subscription and the only thing here with an
            action attached, so it keeps the wider share and reads at full
            height beside the two donuts rather than after them.
        #}
        <section class="card">
            <h2>{{ t('stats.worth_it') }}</h2>
            <p class="muted">{{ t('stats.value_note') }}</p>

            {% if value_signals is empty %}
                <p class="muted empty">{{ t('stats.value_empty') }}</p>
            {% else %}
                <div class="table-scroll">
                    <table class="table">
                        <thead>
                        <tr>
                            <th scope="col">{{ t('field.subscription') }}</th>
                            <th scope="col" class="numeric">{{ t('field.per_month') }}</th>
                            <th scope="col" class="numeric">{{ t('field.uses') }}</th>
                            <th scope="col" class="numeric">{{ t('stats.cost_per_use') }}</th>
                            <th scope="col">{{ t('field.rating') }}</th>
                            <th scope="col"><span class="visually-hidden">{{ t('field.actions') }}</span></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for signal in value_signals %}
                            {% set subscription = signal.subscription %}
                            <tr class="{{ signal.is_low_use ? 'is-urgent' : '' }}">
                                <td>
                                    <a href="/subscriptions/{{ subscription.id }}/money">{{ subscription.name }}</a>
                                    {% if signal.is_low_use %}
                                        <span class="badge badge-warn">{{ t('stats.rarely_used') }}</span>
                                    {% endif %}
                                </td>
                                <td class="numeric num">{{
                                    subscription.monthlyMinor|money(subscription.price.currency) }}</td>
                                <td class="numeric num">
                                    {{ subscription.usageCount }}
                                    {% if signal.uses_per_month is not null %}
                                        <div class="hint">{{ t('stats.uses_per_month', {
                                            'count': signal.uses_per_month|number_format(1),
                                        }) }}</div>
                                    {% endif %}
                                </td>
                                <td class="numeric num">
                                    {% if signal.cost_per_use_minor is not null %}
                                        {{ signal.cost_per_use_minor|money(subscription.price.currency) }}
                                    {% else %}
                                        <span class="muted" title="{{ t('stats.no_uses_recorded') }}" aria-hidden="true">{{ t('common.none_symbol') }}</span>
                                        <span class="visually-hidden">{{ t('stats.no_uses_recorded') }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if subscription.usageRating %}
                                        <span role="img" aria-label="{{ t('stats.rating_label', {
                                            'rating': subscription.usageRating,
                                            'max': max_rating,
                                        }) }}">
                                            <span aria-hidden="true">
                                            {%- for star in 1..max_rating -%}
                                                {{ star <= subscription.usageRating ? '★' : '☆' }}
                                            {%- endfor -%}
                                            </span>
                                        </span>
                                    {% else %}
                                        <span class="muted">{{ t('common.none_symbol') }}</span>
                                    {% endif %}
                                </td>
                                <td class="actions">
                                    {% if can(scope, 'usage.record') and can_edit_row(scope, subscription) %}
                                        <form method="post" action="/subscriptions/{{ subscription.id }}/usage"
                                              class="inline">
                                            {{ csrf_field() }}
                                            <input type="hidden" name="return_to" value="/stats">
                                            <button type="submit" class="button button-quiet">{{ t('stats.used_it') }}</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
