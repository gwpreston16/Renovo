{% extends 'layout.twig' %}

{% block heading %}{{ t('nav.dashboard') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.dashboard') }}{% endblock %}

{% block content %}
    {% if update_banner|default(null) %}
        {% include 'dashboard/_update_banner.twig' with {'banner': update_banner} only %}
    {% endif %}

    {% if not scope.hasHousehold %}
        <section class="card">
            <h2>{{ t('dashboard.no_household') }}</h2>
            <p class="muted">{{ t('dashboard.no_household_note') }}</p>
        </section>
    {% else %}
        {% set shell_context = shell(scope) %}
        {#
            The greeting says who and when, and never "good afternoon": dates
            here are UTC, and a time-of-day greeting would be wrong for anyone
            who is not.
        #}
        <div class="dashboard-head">
            <div>
                <p class="dashboard-greeting">{{ t('dashboard.greeting', {'name': first_name}) }}</p>
                <p class="muted dashboard-date">
                    {{ t('dashboard.stands_on', {
                        'household': shell_context.household ? shell_context.household.name : '',
                        'date': today|local_date('EEEE d MMMM'),
                    }) }}
                </p>
            </div>

            {#
                Two views of one dashboard. A form of two submit buttons rather
                than two links, because choosing one is remembered on the
                account — a write, so it is a POST with its token — and it works
                with no script at all.
            #}
            <div class="dashboard-head-actions">
            <form method="post" action="/dashboard/view" class="segmented dashboard-views"
                  aria-label="{{ t('dashboard.view_choice') }}">
                {{ csrf_field() }}
                {% if editing %}<input type="hidden" name="layout" value="edit">{% endif %}
                {% for choice in dashboard_views %}
                    <button type="submit" name="view" value="{{ choice.value }}" class="segmented-option"
                            aria-pressed="{{ choice == dashboard_view ? 'true' : 'false' }}">
                        {{ t(choice.labelKey) }}
                    </button>
                {% endfor %}
            </form>

            {#
                Customising is a mode of this page rather than a page of its
                own, so what is being arranged is the dashboard itself. A link
                in and a link out: entering and leaving change nothing stored.
            #}
            {% if editing %}
                {#
                    Resets only the view on screen: each view has its own
                    layout. A form, because it is a write; it reloads the
                    page, since every card may have moved or reappeared.
                #}
                <form method="post" action="/dashboard/layout">
                    {{ csrf_field() }}
                    <input type="hidden" name="view" value="{{ dashboard_view.value }}">
                    <button type="submit" name="action" value="reset" class="button button-outline dashboard-customise">
                        {{- icon('reset') }} {{ t('dashboard.layout_reset') -}}
                    </button>
                </form>
                <a href="/" class="button button-primary dashboard-customise">
                    {{- icon('check') }} {{ t('dashboard.layout_done') -}}
                </a>
            {% elseif not demo_mode|default(false) %}
                <a href="/?layout=edit" class="button button-outline dashboard-customise">
                    {{- icon('edit') }} {{ t('dashboard.layout_customise') -}}
                </a>
            {% endif %}
            </div>
        </div>

        {% if editing %}
            <p class="muted dashboard-layout-hint">{{ t('dashboard.layout_hint') }}</p>
            <p class="dashboard-layout-status" role="status" data-card-layout-status></p>
        {% endif %}

        {#
            One template per card, included in the order this user chose for
            this view. The order and the hiding are DashboardLayoutService's;
            this walks the list it produced and nothing else, so adding a card
            is adding a file and an enum case.

            Each card says how many of the six columns and how many rows it
            wants. On a narrow screen every card takes the full width, so the
            same list becomes a stack.

            While customising, every card of the view is walked, hidden ones
            too: a hidden card is a placeholder carrying its name and a Show
            button, so it can be found again. The controls sit beside the card
            rather than around it, because a card may hold a form of its own.
        #}
        {% if editing %}
            <div class="bento is-editing" data-card-layout data-view="{{ dashboard_view.value }}"
                 data-moved-message="{{ t('dashboard.layout_moved', {'card': '{card}', 'position': '{position}'}) }}"
                 data-failed-message="{{ t('dashboard.layout_failed') }}">
                {% for entry in dashboard_layout %}
                    {% set card = entry.card %}
                    <div class="bento-item bento-span-{{ entry.visible ? card.columnSpan : 2 }}{{ entry.visible and card.rowSpan > 1 ? ' bento-rows-' ~ card.rowSpan : '' }}{{ entry.visible ? '' : ' is-hidden-card' }}"
                         id="card-{{ card.value }}" data-card="{{ card.value }}"
                         data-card-name="{{ t(card.labelKey()) }}">
                        {% include 'dashboard/_card_controls.twig' with {
                            'card': card,
                            'visible': entry.visible,
                            'first': loop.first,
                            'last': loop.last,
                        } only %}
                        {% if entry.visible %}
                            {% include card.template %}
                        {% else %}
                            <section class="card card-placeholder">
                                <h2 class="stat-label">{{ t(card.labelKey()) }}</h2>
                                <p class="muted">{{ t('dashboard.layout_hidden') }}</p>
                            </section>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bento">
                {% for card in dashboard_cards %}
                    <div class="bento-item bento-span-{{ card.columnSpan }}{{ card.rowSpan > 1 ? ' bento-rows-' ~ card.rowSpan : '' }}">
                        {% include card.template %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
