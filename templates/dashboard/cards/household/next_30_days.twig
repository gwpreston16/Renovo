{#
    The next thirty days as a line: each charge at its distance from today,
    ticked at today and at the dates a week, two, three and thirty days on,
    with the count and total above, a key to the markers' colours, and the
    charges listed beneath.

    The markers and their key are a picture of the list below them, so they
    are hidden from assistive technology and the list says everything they
    do — a trial's conversion included, which it names in words as well as
    marking in the trial colour.
#}
{% import 'partials/logo.twig' as logo %}

<section class="card timeline-card" aria-labelledby="timeline-heading">
    <header class="card-header">
        <div>
            <h2 id="timeline-heading">{{ t('dashboard.next_days', {'days': timeline.days}) }}</h2>
            <p class="muted">
                {{ t('dashboard.charges_count', {'count': timeline.count}) }}
                {% if timeline.totals is not empty %}
                    · {% include 'dashboard/_headline.twig' with {'figures': timeline} only %}
                {% endif %}
            </p>
        </div>
    </header>

    {% if timeline.markers is empty %}
        <p class="muted empty">{{ t('dashboard.nothing_coming_up', {'days': timeline.days}) }}</p>
    {% else %}
        <div class="timeline" aria-hidden="true">
            <div class="timeline-line"></div>
            {% for tick in timeline.ticks %}
                <span class="timeline-tick{{ loop.first ? ' is-start' : '' }}{{ loop.last ? ' is-end' : '' }}" data-css-left="{{ tick.position }}">
                    {{ tick.days == 0 ? t('dashboard.today') : tick.date|local_date('d MMM') }}
                </span>
            {% endfor %}
            {% for marker in timeline.markers %}
                <span class="timeline-marker lane-{{ marker.lane }}{{ marker.reason == 'trial_conversion' ? ' is-trial' : '' }}"
                      data-css-left="{{ marker.position }}"
                      title="{{ marker.subscription.name }} · {{ marker.date|local_date('d MMM') }} · {{ marker.amount.amountMinor|money(marker.amount.currency) }}">
                    {{ marker.subscription.name|initials }}
                </span>
            {% endfor %}
        </div>

        <ul class="plain timeline-legend" aria-hidden="true">
            <li><span class="timeline-key"></span>{{ t('calendar.kind_charge') }}</li>
            <li><span class="timeline-key is-trial"></span>{{ t('calendar.kind_trial') }}</li>
        </ul>

        <ul class="plain timeline-list">
            {% for marker in timeline.markers %}
                {% set is_trial = marker.reason == 'trial_conversion' %}
                <li class="timeline-item{{ is_trial ? ' is-trial' : '' }}">
                    <span class="timeline-date num">{{ marker.date|local_date('d MMM') }}</span>
                    <span class="timeline-name">
                        {%- if is_trial %}<span class="visually-hidden">{{ t('calendar.kind_trial') }}: </span>{% endif -%}
                        {{ marker.subscription.name }}
                    </span>
                    <span class="num">{{ marker.amount.amountMinor|money(marker.amount.currency) }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
