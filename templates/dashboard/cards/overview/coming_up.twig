{#
    Coming up: every charge and trial conversion in the next thirty days, from
    the forecast — so a trial converting on Friday is here at the price it
    converts to, and a scheduled rise is here at its new price.

    Each amount is in its own currency, with roughly what it is in the base
    currency beside it when that is a different one with a rate.
#}
{% import 'partials/logo.twig' as logo %}
{% import 'partials/avatar.twig' as avatar %}

<section class="card coming-up-card" aria-labelledby="coming-up-heading">
    <header class="card-header">
        <div>
            <h2 id="coming-up-heading">{{ t('dashboard.coming_up') }}</h2>
            <p class="muted">{{ t('dashboard.coming_up_note', {'days': coming_up.days}) }}</p>
        </div>
        <a class="button button-quiet" href="/subscriptions">
            {{ t('dashboard.all_subscriptions') }}{{ icon('arrow-right') }}
        </a>
    </header>

    {% if coming_up.rows is empty %}
        <p class="muted empty">{{ t('dashboard.nothing_coming_up', {'days': coming_up.days}) }}</p>
    {% else %}
        <ul class="plain charge-list">
            {% for row in coming_up.rows %}
                {% set subscription = row.subscription %}
                <li class="charge-row">
                    <span class="date-tile" aria-hidden="true">
                        <span class="date-tile-month">{{ row.date|local_date('MMM') }}</span>
                        <span class="date-tile-day num">{{ row.date|local_date('d') }}</span>
                    </span>
                    {{ logo.mark(subscription) }}
                    <span class="charge-name">
                        <a href="/subscriptions/{{ subscription.id }}{{ can_edit_row(scope, subscription) ? '/edit' : '/money' }}">{{ subscription.name }}</a>
                        <span class="hint">
                            <span class="visually-hidden">{{ row.date|local_date('d MMMM') }} · </span>
                            {% if row.is_trial_conversion %}{{ t('dashboard.trial_converts') }}{% elseif subscription.billingCycle %}{{ cycle_label(subscription.billingCycle.value, subscription.cycleDays, subscription.cycleInterval) }}{% endif %}
                        </span>
                    </span>
                    {% if subscription.ownerName %}
                        <span class="charge-owner" title="{{ subscription.ownerName }}">
                            {{ avatar.face(subscription.ownerUserId, subscription.ownerName, subscription.ownerHasAvatar, 24) }}
                            <span class="visually-hidden">{{ subscription.ownerName }}</span>
                        </span>
                    {% endif %}
                    <span class="charge-amount">
                        {% set amount = row.amount.amountMinor|money(row.amount.currency) %}
                        <span class="num">{{ subscription.amountVaries ? t('subscriptions_list.approximately', {'amount': amount}) : amount }}</span>
                        {% if row.approx_base %}
                            <span class="hint num">{{ t('dashboard.approx', {'amount': row.approx_base.amountMinor|money(row.approx_base.currency)}) }}</span>
                        {% endif %}
                    </span>
                    {% if row.is_trial_conversion %}
                        <span class="badge badge-warn">{{ t('state.trial') }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        {% if coming_up.more > 0 %}
            <p class="hint coming-up-more">
                {{ t('dashboard.coming_up_more', {'count': coming_up.more, 'days': coming_up.days}) }}
                <a href="/calendar">{{ t('nav.calendar') }}</a>
            </p>
        {% endif %}
    {% endif %}
</section>
