{#
    Categories: the household's, as chips, each with how many subscriptions
    are filed under it.

    A chip opens in place to rename it — the name and its colour, one form —
    or to delete it. Deleting unfiles its subscriptions and keeps them. The
    disclosure is a `<details>`, so it needs no script, and a rename that
    failed validation comes back open with its error beside the field.

    The count is of the subscriptions this reader can see: in ISOLATED mode a
    member's count is of their own, as every other figure is.

    Managing them is `category.manage`; everybody else sees the chips.
#}
{% set may_manage = can(scope, 'category.manage') %}

<section class="card" id="categories" aria-labelledby="categories-heading">
    <h2 id="categories-heading">{{ t('nav.categories') }}</h2>
    <p class="muted">{{ t('settings.categories_intro') }}</p>

    {% if categories is empty %}
        <p class="muted empty">{{ t('categories.no_categories_yet') }}</p>
    {% else %}
        <ul class="setting-chips">
            {% for entry in categories %}
                {% set category = entry.item %}
                {% set is_failed = failed.section == 'categories' and failed.id == category.id %}
                <li>
                    {% if may_manage %}
                        <details class="setting-chip" {{ is_failed ? 'open' : '' }}>
                            <summary>
                                <span class="swatch" data-css-background="{{ category.colour|default('#888888') }}" aria-hidden="true"></span>
                                <span class="setting-chip-name">{{ category.name }}</span>
                                <span class="setting-chip-count num">{{ entry.count }}<span class="visually-hidden"> {{ t('settings.subscriptions_count', {'count': entry.count}) }}</span></span>
                                {{ icon('edit', 'setting-chip-icon') }}
                            </summary>

                            <div class="setting-chip-panel">
                                <form method="post" action="/categories/{{ category.id }}" class="inline-form">
                                    {{ csrf_field() }}
                                    <input type="text" name="name" maxlength="60" required
                                           value="{{ is_failed ? values.name|default(category.name) : category.name }}"
                                           aria-label="{{ t('settings.rename_category', {'name': category.name}) }}">
                                    <input type="color" name="colour" value="{{ category.colour|default('#888888') }}"
                                           aria-label="{{ t('categories.category_colour') }}">
                                    <button type="submit" class="button button-outline">{{ t('action.save') }}</button>
                                </form>
                                {% if is_failed and errors.name is defined %}<p class="field-error">{{ error_message(errors.name) }}</p>{% endif %}
                                {% if is_failed and errors.colour is defined %}<p class="field-error">{{ error_message(errors.colour) }}</p>{% endif %}

                                <form method="post" action="/categories/{{ category.id }}/delete" class="inline"
                                      data-confirm="{{ t('confirm.delete_category', {'name': category.name}) }}">
                                    {{ csrf_field() }}
                                    <button type="submit" class="button button-danger">
                                        {{ icon('delete') }}{{ t('settings.delete_named', {'name': category.name}) }}
                                    </button>
                                </form>
                            </div>
                        </details>
                    {% else %}
                        <span class="setting-chip is-static">
                            <span class="swatch" data-css-background="{{ category.colour|default('#888888') }}" aria-hidden="true"></span>
                            <span class="setting-chip-name">{{ category.name }}</span>
                            <span class="setting-chip-count num">{{ entry.count }}<span class="visually-hidden"> {{ t('settings.subscriptions_count', {'count': entry.count}) }}</span></span>
                        </span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if may_manage %}
        {% set new_failed = failed.section == 'categories' and failed.id is null %}
        <form method="post" action="/categories" class="setting-add">
            {{ csrf_field() }}
            <label for="new_category" class="visually-hidden">{{ t('categories.new_category') }}</label>
            <input type="text" id="new_category" name="name" maxlength="60" required
                   placeholder="{{ t('categories.new_category') }}"
                   value="{{ new_failed ? values.name|default('') : '' }}">
            <input type="color" name="colour" value="{{ new_failed ? values.colour|default('#4f7df0') : '#4f7df0' }}"
                   aria-label="{{ t('categories.colour') }}">
            <button type="submit" class="button button-outline">{{ icon('add') }}{{ t('action.add') }}</button>
        </form>
        {% if new_failed and errors.name is defined %}<p class="field-error">{{ error_message(errors.name) }}</p>{% endif %}
        {% if new_failed and errors.colour is defined %}<p class="field-error">{{ error_message(errors.colour) }}</p>{% endif %}
    {% endif %}
</section>
