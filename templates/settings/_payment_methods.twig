{% import 'partials/payment_method.twig' as payment_method %}

{#
    Payment methods: Phase 17's management, as a section of General, drawn
    the way categories and tags are — the methods as chips, and the form that
    adds one beneath them.

    A chip opens in place to edit it, with one addition over a category: the
    logo. A failed edit comes back open with its errors beside the fields. A
    form carrying a file is multipart; one that does not upload anything
    leaves the logo as it was, so renaming a method never loses its picture.
    Clearing the logo is a separate, deliberate button.

    The colour is optional. An `<input type="color">` always submits some
    colour, so "automatic" is a checkbox beside it: a method with no colour of
    its own takes the theme's series palette in the breakdown, which follows
    light and dark where a stored hex cannot.

    Managed by the same people as categories (`category.manage`).
#}
{% set may_manage = can(scope, 'category.manage') %}
{% set failed_id = failed.section == 'payment_methods' ? failed.id : false %}

<section class="card" id="payment-methods" aria-labelledby="payment-methods-heading">
    <h2 id="payment-methods-heading">{{ t('nav.payment_methods') }}</h2>
    <p class="muted">{{ t('payment_methods.intro') }}</p>

    {% if payment_methods is empty %}
        <p class="muted empty">{{ t('payment_methods.none_yet') }}</p>

        {% if may_manage %}
            <form method="post" action="/payment-methods/defaults" class="stack">
                {{ csrf_field() }}
                <p class="hint">{{ t('payment_methods.defaults_hint') }}</p>
                <div class="form-actions">
                    <button type="submit" class="button">{{ t('payment_methods.add_defaults') }}</button>
                </div>
            </form>
        {% endif %}
    {% else %}
        <ul class="setting-chips">
            {% for method in payment_methods %}
                {% set is_failed = failed_id == method.id %}
                {% set row_errors = is_failed ? errors : {} %}
                <li>
                    {% if may_manage %}
                        <details class="setting-chip" {{ is_failed ? 'open' : '' }}>
                            <summary>
                                {% if method.colour %}<span class="swatch" data-css-background="{{ method.colour }}" aria-hidden="true"></span>{% endif %}
                                {{ payment_method.badge(method.name, method.icon, method.logoPath) }}
                                {{ icon('edit', 'setting-chip-icon') }}
                            </summary>

                            <div class="setting-chip-panel">
                                <form method="post" action="/payment-methods/{{ method.id }}"
                                      enctype="multipart/form-data" class="inline-form">
                                    {{ csrf_field() }}
                                    <input type="text" name="name" value="{{ is_failed ? values.name|default(method.name) : method.name }}"
                                           aria-label="{{ t('payment_methods.name_of', {'name': method.name}) }}">
                                    <input type="color" name="colour" value="{{ method.colour|default('#888888') }}"
                                           aria-label="{{ t('payment_methods.colour_of', {'name': method.name}) }}">
                                    <label class="choice">
                                        <input type="checkbox" name="colour_auto" value="1"
                                               aria-label="{{ t('payment_methods.colour_automatic_of', {'name': method.name}) }}"
                                               {{ method.colour is null ? 'checked' : '' }}>
                                        {{ t('payment_methods.colour_automatic') }}
                                    </label>
                                    <input type="file" name="logo" accept="image/png,image/jpeg,image/gif,image/webp"
                                           aria-label="{{ t('payment_methods.logo_of', {'name': method.name}) }}">
                                    <button type="submit" class="button button-outline">{{ t('action.save') }}</button>
                                </form>
                                {% if row_errors.name is defined %}<p class="field-error">{{ error_message(row_errors.name) }}</p>{% endif %}
                                {% if row_errors.colour is defined %}<p class="field-error">{{ error_message(row_errors.colour) }}</p>{% endif %}
                                {% if row_errors.logo is defined %}<p class="field-error">{{ error_message(row_errors.logo) }}</p>{% endif %}

                                {% if method.logoPath %}
                                    <form method="post" action="/payment-methods/{{ method.id }}/logo/clear" class="inline">
                                        {{ csrf_field() }}
                                        <button type="submit" class="button button-quiet">{{ t('payment_methods.clear_logo') }}</button>
                                    </form>
                                {% endif %}
                                <form method="post" action="/payment-methods/{{ method.id }}/delete" class="inline"
                                      data-confirm="{{ t('confirm.delete_payment_method', {'name': method.name}) }}">
                                    {{ csrf_field() }}
                                    <button type="submit" class="button button-danger">
                                        {{ icon('delete') }}{{ t('settings.delete_named', {'name': method.name}) }}
                                    </button>
                                </form>
                            </div>
                        </details>
                    {% else %}
                        <span class="setting-chip is-static">
                            {% if method.colour %}<span class="swatch" data-css-background="{{ method.colour }}" aria-hidden="true"></span>{% endif %}
                            {{ payment_method.badge(method.name, method.icon, method.logoPath) }}
                        </span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if may_manage %}
        {% set new_errors = failed_id is null ? errors : {} %}
        {% set new_values = failed_id is null ? values : {} %}
        <form method="post" action="/payment-methods" enctype="multipart/form-data" class="stack setting-add-method">
            {{ csrf_field() }}
            <div class="setting-add">
                <label for="new_payment_method" class="visually-hidden">{{ t('payment_methods.new_method') }}</label>
                <input type="text" id="new_payment_method" name="name" required
                       placeholder="{{ t('payment_methods.new_method') }}"
                       value="{{ new_values.name|default('') }}">
                <input type="color" name="colour" value="{{ new_values.colour|default('#4f7df0') }}"
                       aria-label="{{ t('categories.colour') }}">
                <button type="submit" class="button button-outline">{{ icon('add') }}{{ t('action.add') }}</button>
            </div>
            <label class="choice">
                <input type="checkbox" name="colour_auto" value="1"
                       {{ new_values is empty or new_values.colour_auto is defined ? 'checked' : '' }}>
                {{ t('payment_methods.colour_automatic') }}
            </label>
            {% if new_errors.name is defined %}<p class="field-error">{{ error_message(new_errors.name) }}</p>{% endif %}
            {% if new_errors.colour is defined %}<p class="field-error">{{ error_message(new_errors.colour) }}</p>{% endif %}

            <div class="field">
                <label for="new-logo">{{ t('payment_methods.logo') }}</label>
                <input type="file" id="new-logo" name="logo" accept="image/png,image/jpeg,image/gif,image/webp"
                       aria-describedby="new-logo-hint">
                <p class="hint" id="new-logo-hint">{{ t('payment_methods.logo_hint') }}</p>
                {% if new_errors.logo is defined %}<p class="field-error">{{ error_message(new_errors.logo) }}</p>{% endif %}
            </div>
        </form>
    {% endif %}
</section>
