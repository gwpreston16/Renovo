{% extends 'layout.twig' %}

{% block heading %}{{ t('nav.settings') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.settings') }}{% endblock %}

{#
    Settings — Instance: what applies to every account on this server.
    Instance administrators only; the route answers 403 to everybody else,
    and the tab is not offered to them.

    Registration, isolation (the one place it is changed — decision 3), demo
    mode and the update check are one form; the trusted hosts are a list of
    their own. The rest is the server as its environment describes it — the
    release and what the update check found, the mail relay, the metrics
    endpoint, the scheduler's last run, the last instance backup — read-only,
    apart from Check now. The relay is described, never revealed: no password.
    Instance backups have a card of their own (Phase 38).

    `SettingsController::instance()` renders it.
#}
{% block content %}
    {% include 'settings/_tabs.twig' with {'tab': 'instance'} %}

    <div class="profile-row">
        <section class="card" id="instance-settings" aria-labelledby="instance-settings-heading">
            <h2 id="instance-settings-heading">{{ t('settings.instance') }}</h2>
            <p class="muted">{{ t('settings.instance_note') }}</p>

            <form method="post" action="/settings/instance" class="stack">
                {{ csrf_field() }}

                <input type="hidden" name="allow_registration" value="0">
                <label class="choice toggle-row">
                    <span>
                        <span class="choice-title">{{ t('settings.allow_registration') }}</span>
                        <span class="choice-note">{{ t('settings.allow_registration_hint') }}</span>
                    </span>
                    <input type="checkbox" class="toggle" role="switch" name="allow_registration" value="1"
                           {{ allow_registration ? 'checked' : '' }}>
                </label>

                <fieldset class="role-options" id="data-isolation">
                    <legend>{{ t('settings.data_isolation') }}</legend>
                    {% for mode in isolation_modes %}
                        <label class="role-option">
                            <input type="radio" name="isolation_mode" value="{{ mode.value }}"
                                   {{ isolation_mode == mode.value ? 'checked' : '' }}>
                            <span class="role-option-text">{{ isolation_label(mode.value) }}</span>
                        </label>
                    {% endfor %}
                </fieldset>

                <input type="hidden" name="demo_mode" value="0">
                <label class="choice toggle-row">
                    <span>
                        <span class="choice-title">{{ t('settings.demo_mode') }}</span>
                        <span class="choice-note">{{ t('settings.demo_mode_hint') }}</span>
                    </span>
                    <input type="checkbox" class="toggle" role="switch" name="demo_mode" value="1"
                           {{ demo_mode ? 'checked' : '' }}>
                </label>

                {#
                    Updates. A switch that cannot be changed posts nothing —
                    not even its hidden "0" — so saving this form while checks
                    are off, or while the environment rules them out, leaves
                    the stored choice as it was.
                #}
                {% set updates_locked = updates_unavailable is not null %}
                <fieldset class="stack" id="updates">
                    <legend>{{ t('settings.updates') }}</legend>

                    {% if updates_locked %}
                        <p class="muted note">{{ t(updates_unavailable.labelKey) }}</p>
                    {% else %}
                        <input type="hidden" name="update_check_enabled" value="0">
                    {% endif %}
                    <label class="choice toggle-row">
                        <span>
                            <span class="choice-title">{{ t('settings.update_check') }}</span>
                            <span class="choice-note">{{ t('settings.update_check_hint') }}</span>
                        </span>
                        <input type="checkbox" class="toggle" role="switch" name="update_check_enabled" value="1"
                               {{ update_check_enabled and not updates_locked ? 'checked' : '' }}
                               {{ updates_locked ? 'disabled' : '' }}>
                    </label>

                    {% set banner_locked = updates_locked or not update_check_enabled %}
                    {% if not banner_locked %}
                        <input type="hidden" name="update_banner_enabled" value="0">
                    {% endif %}
                    <label class="choice toggle-row">
                        <span>
                            <span class="choice-title">{{ t('settings.update_banner') }}</span>
                            <span class="choice-note">{{ t('settings.update_banner_hint') }}</span>
                        </span>
                        <input type="checkbox" class="toggle" role="switch" name="update_banner_enabled" value="1"
                               {{ update_banner_enabled ? 'checked' : '' }}
                               {{ banner_locked ? 'disabled' : '' }}>
                    </label>
                </fieldset>

                <div class="form-actions">
                    <button type="submit" class="button button-outline">{{ t('settings.save_instance_settings') }}</button>
                </div>
            </form>
        </section>

        <section class="card" id="instance-status" aria-labelledby="instance-status-heading">
            <h2 id="instance-status-heading">{{ t('settings.instance_status') }}</h2>
            <p class="muted">{{ t('settings.instance_status_intro') }}</p>

            <dl class="settings-facts">
                {#
                    The release, first; and, while update checks are on, what
                    the last check found. The release-notes link is GitHub's
                    page in a new tab, drawn only when it is on github.com.
                #}
                <dt>{{ t('settings.status_version') }}</dt>
                <dd>
                    <span class="num">{{ version }}</span>
                    {%- if version_build %} <span class="muted num">({{ version_build }})</span>{% endif %}

                    {% if update.state.value == 'up_to_date' %}
                        <span class="badge badge-ok">{{ t('updates.up_to_date') }}</span>
                    {% elseif update.state.value == 'available' %}
                        <span class="badge badge-warn">{{ t('updates.available', {'version': update.latestVersion}) }}</span>
                    {% endif %}

                    {% if update.state.value != 'off' %}
                        <span class="muted block">
                            {% if update.state.value == 'failed' %}
                                {{ t('updates.last_check_failed', {'date': update.lastAttemptAt|local_date('d MMM y, HH:mm')}) }}
                            {% elseif update.state.value == 'never_checked' %}
                                {{ t('updates.never_checked') }}
                            {% elseif update.state.value == 'no_releases' %}
                                {{ t('updates.no_releases') }}
                            {% else %}
                                {{ t('updates.checked_at', {'date': update.checkedAt|local_date('d MMM y, HH:mm')}) }}
                            {% endif %}
                            {% if update.state.value == 'available' and update.releaseUrl %}
                                · <a href="{{ update.releaseUrl }}" target="_blank" rel="noopener">
                                    {{- t('updates.release_notes') -}}
                                    <span class="visually-hidden"> {{ t('updates.new_tab') }}</span></a>
                            {% endif %}
                        </span>

                        <form method="post" action="/settings/updates/check" class="inline">
                            {{ csrf_field() }}
                            <button type="submit" class="button button-quiet">{{ t('updates.check_now') }}</button>
                        </form>
                    {% endif %}
                </dd>

                <dt>{{ t('settings.status_mail') }}</dt>
                <dd>
                    <span class="num">{{ smtp.host }}:{{ smtp.port }}</span>
                    <span class="muted block">
                        {{ t('settings.status_mail_encryption', {'encryption': smtp.encryption}) }} ·
                        {{ smtp.authenticates ? t('settings.status_mail_signs_in') : t('settings.status_mail_no_sign_in') }}
                    </span>
                </dd>

                <dt>{{ t('settings.status_metrics') }}</dt>
                <dd>
                    {% if metrics_enabled %}
                        <span class="badge badge-ok">{{ t('state.on') }}</span>
                        <span class="muted block">{{ t('settings.status_metrics_on') }}</span>
                    {% else %}
                        <span class="badge">{{ t('state.off') }}</span>
                        <span class="muted block">{{ t('settings.status_metrics_off', {'variable': 'METRICS_TOKEN'}) }}</span>
                    {% endif %}
                </dd>

                <dt>{{ t('settings.status_secrets_key') }}</dt>
                <dd>
                    {% if secrets_key_set %}
                        <span class="badge badge-ok">{{ t('settings.status_secrets_key_set') }}</span>
                        <span class="muted block">{{ t('settings.status_secrets_key_set_hint') }}</span>
                    {% else %}
                        <span class="badge badge-warn">{{ t('settings.status_secrets_key_unset') }}</span>
                        <span class="muted block">{{ t('settings.status_secrets_key_unset_hint', {'variable': 'SECRETS_KEY', 'session': 'SESSION_KEY'}) }}</span>
                    {% endif %}
                </dd>

                <dt>{{ t('settings.status_scheduler') }}</dt>
                <dd>
                    {% if scheduler_last_run_at %}
                        <span class="num">{{ scheduler_last_run_at|local_date('d MMM y, HH:mm') }}</span>
                    {% else %}
                        <span class="muted">{{ t('settings.status_scheduler_never') }}</span>
                    {% endif %}
                </dd>

                <dt>{{ t('settings.status_instance_backup') }}</dt>
                <dd>
                    {% if backups.last_verified %}
                        <a class="num" href="#instance-backups">{{ backups.last_verified.startedAt|local_date('d MMM y, HH:mm') }}</a>
                    {% elseif backups.key_state == 'ok' %}
                        <span class="muted">{{ t('settings.status_instance_backup_never') }}</span>
                    {% else %}
                        <span class="muted">{{ t('settings.status_instance_backup_no_key', {'variable': 'BACKUP_ENCRYPTION_KEY'}) }}</span>
                    {% endif %}
                </dd>
            </dl>
        </section>
    </div>

    {#
        Instance backups (Phase 38): the whole database and every stored
        file, encrypted under BACKUP_ENCRYPTION_KEY. The key is shown by its
        fingerprint and never otherwise; without it the controls are drawn
        disabled and the card says what to set. There is no restore here —
        that is `bin/console backup:restore`, on purpose.
    #}
    {% set backup_ready = backups.key_state == 'ok' %}
    <section class="card" id="instance-backups" aria-labelledby="instance-backups-heading">
        <h2 id="instance-backups-heading">{{ t('backup.instance_heading') }}</h2>
        <p class="muted">{{ t('backup.instance_intro') }}</p>

        {% if backups.local_only %}
            <p class="alert callout instance-backup-warning" role="note">
                {{ icon('warn') }}{{ t('backup.instance_same_server', {'variable': 'BACKUP_DIRECTORY'}) }}
            </p>
        {% endif %}

        <dl class="settings-facts">
            <dt>{{ t('backup.instance_key') }}</dt>
            <dd>
                {% if backup_ready %}
                    <span class="num">{{ backups.fingerprint }}</span>
                    <span class="badge badge-ok">{{ t('backup.instance_key_set') }}</span>
                    <span class="muted block">{{ t('backup.instance_keys_elsewhere', {
                        'backup': 'BACKUP_ENCRYPTION_KEY',
                        'session': 'SESSION_KEY',
                        'secrets': 'SECRETS_KEY',
                        'previous': 'SECRETS_PREVIOUS_KEYS',
                        'totp': 'TOTP_ENCRYPTION_KEY',
                    }) }}</span>
                {% elseif backups.key_state == 'invalid' %}
                    <span class="badge badge-bad">{{ t('backup.instance_key_invalid') }}</span>
                    <span class="muted block">{{ t('backup.instance_key_invalid_hint', {'variable': 'BACKUP_ENCRYPTION_KEY'}) }}</span>
                {% else %}
                    <span class="badge badge-warn">{{ t('backup.instance_key_missing') }}</span>
                    <span class="muted block">{{ t('backup.instance_key_missing_hint', {'variable': 'BACKUP_ENCRYPTION_KEY'}) }}</span>
                {% endif %}
            </dd>

            <dt>{{ t('backup.instance_directory') }}</dt>
            <dd><code>{{ backups.directory }}</code></dd>
        </dl>

        <form method="post" action="/settings/backups" class="stack">
            {{ csrf_field() }}

            <fieldset class="role-options" id="backup-schedule" {{ backup_ready ? '' : 'disabled' }}>
                <legend>{{ t('backup.instance_schedule') }}</legend>
                {% for schedule in backups.schedules %}
                    <label class="role-option">
                        <input type="radio" name="schedule" value="{{ schedule.value }}"
                               {{ backups.schedule == schedule.value ? 'checked' : '' }}>
                        <span class="role-option-text">{{ t(schedule.labelKey()) }}</span>
                    </label>
                {% endfor %}
            </fieldset>

            <fieldset class="stack" id="backup-retention">
                <legend>{{ t('backup.instance_retention') }}</legend>
                <p class="hint">{{ t('backup.instance_retention_hint') }}</p>
                <div class="field-grid field-grid-3 backup-retention">
                    {% for field in ['daily', 'weekly', 'monthly'] %}
                        <div class="field">
                            <label for="keep-{{ field }}">{{ t('backup.instance_keep_' ~ field) }}</label>
                            <input type="number" id="keep-{{ field }}" name="keep_{{ field }}" class="num"
                                   min="0" max="{{ backups.max_retention }}" required
                                   value="{{ attribute(backups.retention, field) }}">
                        </div>
                    {% endfor %}
                </div>
            </fieldset>

            <div class="form-actions">
                <button type="submit" class="button button-outline">{{ t('backup.instance_save') }}</button>
            </div>
        </form>

        <form method="post" action="/settings/backups/run" class="form-actions">
            {{ csrf_field() }}
            <button type="submit" class="button button-primary" {{ backup_ready ? '' : 'disabled' }}>
                {{- icon('lock') }}{{ t('backup.instance_back_up_now') -}}
            </button>
            <span class="hint">{{ t('backup.instance_back_up_now_hint') }}</span>
        </form>

        <h3 class="instance-backup-history-heading">{{ t('backup.instance_history') }}</h3>
        {% if backups.history is empty %}
            <p class="muted empty">{{ t('backup.instance_history_empty') }}</p>
        {% else %}
            <ul class="account-rows instance-backup-rows">
                {% for item in backups.history %}
                    {% set run = item.run %}
                    <li class="account-row">
                        <span class="account-row-icon" aria-hidden="true">{{ icon(run.status == 'failed' ? 'warn' : 'lock') }}</span>
                        <div class="account-row-text">
                            <span class="account-row-name">
                                <span class="num">{{ run.startedAt|local_date('d MMM y, HH:mm') }}</span>
                                {% if run.status == 'verified' %}
                                    <span class="badge badge-ok">{{ t('backup.status.verified') }}</span>
                                {% elseif run.status == 'failed' %}
                                    <span class="badge badge-bad">{{ t('backup.status.failed') }}</span>
                                {% else %}
                                    <span class="badge badge-info">{{ t('backup.status.running') }}</span>
                                {% endif %}
                                {% if run.prunedAt %}<span class="badge">{{ t('backup.status.pruned') }}</span>{% endif %}
                            </span>
                            <span class="account-row-meta">
                                {{ t('backup.trigger.' ~ run.trigger) }}
                                {%- if run.durationSeconds() is not null %} · <span class="num">{{ t('backup.duration', {'seconds': run.durationSeconds()}) }}</span>{% endif %}
                                {%- if item.size %} · <span class="num">{{ t(item.size.key, {'size': item.size.value|decimal(item.size.digits)}) }}</span>{% endif %}
                                {%- if run.keyFingerprint %} · {{ t('backup.key_short') }} <span class="num">{{ run.keyFingerprint }}</span>{% endif %}
                            </span>
                            {% if run.status == 'failed' %}
                                <span class="account-row-meta instance-backup-error">{{ t('backup.reason.' ~ (run.error ?? 'unexpected')) }}</span>
                            {% endif %}
                            {% if run.warnings is not empty %}
                                <details class="instance-backup-warnings">
                                    <summary class="account-row-meta">{{ t('backup.warnings', {'count': run.warnings|length}) }}</summary>
                                    <ul class="hint">
                                        {% for warning in run.warnings %}
                                            <li>{{ t('backup.warning.' ~ warning.code) }} <code>{{ warning.detail }}</code></li>
                                        {% endfor %}
                                    </ul>
                                </details>
                            {% endif %}
                        </div>
                        {% if run.isAvailable() %}
                            <div class="account-row-actions">
                                <a class="button button-quiet" href="/settings/backups/{{ run.id }}/download" download
                                   aria-label="{{ t('backup.download_named', {'date': run.startedAt|local_date('d MMM y, HH:mm')}) }}">
                                    {{- icon('download') }}{{ t('action.download') -}}
                                </a>
                            </div>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="card" id="trusted-hosts" aria-labelledby="trusted-hosts-heading">
        <h2 id="trusted-hosts-heading">{{ t('settings.trusted_hosts') }}</h2>

        <p class="muted note">{{ t('settings.trusted_hosts_intro') }}</p>
        <p class="muted note">{{ t('settings.trusted_hosts_exception') }} <code>http</code>.</p>

        {% if trusted_hosts is empty %}
            <p class="muted empty">{{ t('settings.trusted_hosts_empty') }}</p>
        {% else %}
            <div class="table-scroll">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">{{ t('settings.host_or_range') }}</th>
                        <th scope="col">{{ t('field.note') }}</th>
                        <th scope="col">{{ t('field.added') }}</th>
                        <th scope="col"><span class="visually-hidden">{{ t('field.actions') }}</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for host in trusted_hosts %}
                        <tr>
                            <td><code>{{ host.pattern }}</code></td>
                            <td>{{ host.note }}</td>
                            <td class="num">
                                {{ host.created_at|local_date('d MMM y') }}
                                {% if host.created_by %}<span class="muted">{{ t('settings.added_by', {'name': host.created_by}) }}</span>{% endif %}
                            </td>
                            <td class="actions">
                                <form method="post" action="/settings/trusted-hosts/{{ host.id }}/delete" class="inline">
                                    {{ csrf_field() }}
                                    <button type="submit" class="button button-quiet"
                                            aria-label="{{ t('settings.remove_named', {'name': host.pattern}) }}">{{ t('action.remove') }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <form method="post" action="/settings/trusted-hosts" class="stack">
            {{ csrf_field() }}

            <label for="trusted_pattern">{{ t('settings.host_address_or_range') }}</label>
            <input type="text" id="trusted_pattern" name="pattern"
                   placeholder="{{ t('settings.trusted_host_placeholder') }}" required>

            <label for="trusted_note">{{ t('field.note') }}</label>
            <input type="text" id="trusted_note" name="note" placeholder="{{ t('settings.trusted_host_note_placeholder') }}">

            <div class="form-actions">
                <button type="submit" class="button button-outline">{{ t('settings.trust_this_host') }}</button>
            </div>
        </form>
    </section>
{% endblock %}
