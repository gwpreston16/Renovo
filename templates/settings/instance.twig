{% extends 'layout.twig' %}

{% block heading %}{{ t('nav.settings') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.settings') }}{% endblock %}

{#
    Settings — Instance: what applies to every account on this server.
    Instance administrators only; the route answers 403 to everybody else,
    and the tab is not offered to them.

    Registration, isolation (the one place it is changed — decision 3), demo
    mode and the update check are one form; the trusted hosts are a list of
    their own. The rest is the server as its environment describes it — the
    release and what the update check found, the mail relay, the metrics
    endpoint, the scheduler's last run, the last instance backup — read-only,
    apart from Check now. The relay is described, never revealed: no password.
    Instance backups have a card of their own (Phase 38).

    `SettingsController::instance()` renders it.
#}
{% block content %}
    {% include 'settings/_tabs.twig' with {'tab': 'instance'} %}

    <div class="profile-row">
        <section class="card" id="instance-settings" aria-labelledby="instance-settings-heading">
            <h2 id="instance-settings-heading">{{ t('settings.instance') }}</h2>
            <p class="muted">{{ t('settings.instance_note') }}</p>

            <form method="post" action="/settings/instance" class="stack">
                {{ csrf_field() }}

                <input type="hidden" name="allow_registration" value="0">
                <label class="choice toggle-row">
                    <span>
                        <span class="choice-title">{{ t('settings.allow_registration') }}</span>
                        <span class="choice-note">{{ t('settings.allow_registration_hint') }}</span>
                    </span>
                    <input type="checkbox" class="toggle" role="switch" name="allow_registration" value="1"
                           {{ allow_registration ? 'checked' : '' }}>
                </label>

                <fieldset class="role-options" id="data-isolation">
                    <legend>{{ t('settings.data_isolation') }}</legend>
                    {% for mode in isolation_modes %}
                        <label class="role-option">
                            <input type="radio" name="isolation_mode" value="{{ mode.value }}"
                                   {{ isolation_mode == mode.value ? 'checked' : '' }}>
                            <span class="role-option-text">{{ isolation_label(mode.value) }}</span>
                        </label>
                    {% endfor %}
                </fieldset>

                <input type="hidden" name="demo_mode" value="0">
                <label class="choice toggle-row">
                    <span>
                        <span class="choice-title">{{ t('settings.demo_mode') }}</span>
                        <span class="choice-note">{{ t('settings.demo_mode_hint') }}</span>
                    </span>
                    <input type="checkbox" class="toggle" role="switch" name="demo_mode" value="1"
                           {{ demo_mode ? 'checked' : '' }}>
                </label>

                {#
                    Updates. A switch that cannot be changed posts nothing —
                    not even its hidden "0" — so saving this form while checks
                    are off, or while the environment rules them out, leaves
                    the stored choice as it was.
                #}
                {% set updates_locked = updates_unavailable is not null %}
                <fieldset class="stack" id="updates">
                    <legend>{{ t('settings.updates') }}</legend>

                    {% if updates_locked %}
                        <p class="muted note">{{ t(updates_unavailable.labelKey) }}</p>
                    {% else %}
                        <input type="hidden" name="update_check_enabled" value="0">
                    {% endif %}
                    <label class="choice toggle-row">
                        <span>
                            <span class="choice-title">{{ t('settings.update_check') }}</span>
                            <span class="choice-note">{{ t('settings.update_check_hint') }}</span>
                        </span>
                        <input type="checkbox" class="toggle" role="switch" name="update_check_enabled" value="1"
                               {{ update_check_enabled and not updates_locked ? 'checked' : '' }}
                               {{ updates_locked ? 'disabled' : '' }}>
                    </label>

                    {% set banner_locked = updates_locked or not update_check_enabled %}
                    {% if not banner_locked %}
                        <input type="hidden" name="update_banner_enabled" value="0">
                    {% endif %}
                    <label class="choice toggle-row">
                        <span>
                            <span class="choice-title">{{ t('settings.update_banner') }}</span>
                            <span class="choice-note">{{ t('settings.update_banner_hint') }}</span>
                        </span>
                        <input type="checkbox" class="toggle" role="switch" name="update_banner_enabled" value="1"
                               {{ update_banner_enabled and not banner_locked ? 'checked' : '' }}
                               {{ banner_locked ? 'disabled' : '' }}>
                    </label>
                </fieldset>

                <div class="form-actions">
                    <button type="submit" class="button button-outline">{{ t('settings.save_instance_settings') }}</button>
                </div>
            </form>
        </section>

        <section class="card" id="instance-status" aria-labelledby="instance-status-heading">
            <h2 id="instance-status-heading">{{ t('settings.instance_status') }}</h2>
            <p class="muted">{{ t('settings.instance_status_intro') }}</p>

            <dl class="settings-facts">
                {#
                    The release, first; and, while update checks are on, what
                    the last check found. The release-notes link is GitHub's
                    page in a new tab, drawn only when it is on github.com.
                #}
                <dt>{{ t('settings.status_version') }}</dt>
                <dd>
                    <span class="num">{{ version }}</span>
                    {%- if version_build %} <span class="muted num">({{ version_build }})</span>{% endif %}

                    {% if update.state.value == 'up_to_date' %}
                        <span class="badge badge-ok">{{ t('updates.up_to_date') }}</span>
                    {% elseif update.state.value == 'available' %}
                        <span class="badge badge-warn">{{ t('updates.available', {'version': update.latestVersion}) }}</span>
                    {% endif %}

                    {% if update.state.value != 'off' %}
                        <span class="muted block">
                            {% if update.state.value == 'failed' %}
                                {{ t('updates.last_check_failed', {'date': update.lastAttemptAt|local_date('d MMM y, HH:mm')}) }}
                            {% elseif update.state.value == 'never_checked' %}
                                {{ t('updates.never_checked') }}
                            {% elseif update.state.value == 'no_releases' %}
                                {{ t('updates.no_releases') }}
                            {% else %}
                                {{ t('updates.checked_at', {'date': update.checkedAt|local_date('d MMM y, HH:mm')}) }}
                            {% endif %}
                            {% if update.state.value == 'available' and update.releaseUrl %}
                                · <a href="{{ update.releaseUrl }}" target="_blank" rel="noopener">
                                    {{- t('updates.release_notes') -}}
                                    <span class="visually-hidden"> {{ t('updates.new_tab') }}</span></a>
                            {% endif %}
                        </span>

                        <form method="post" action="/settings/updates/check" class="inline">
                            {{ csrf_field() }}
                            <button type="submit" class="button button-quiet">{{ t('updates.check_now') }}</button>
                        </form>
                    {% endif %}
                </dd>

                <dt>{{ t('settings.status_mail') }}</dt>
                <dd>
                    <span class="num">{{ smtp.host }}:{{ smtp.port }}</span>
                    <span class="muted block">
                        {{ t('settings.status_mail_encryption', {'encryption': smtp.encryption}) }} ·
                        {{ smtp.authenticates ? t('settings.status_mail_signs_in') : t('settings.status_mail_no_sign_in') }}
                    </span>
                </dd>

                {#
                    Outbound requests (Phase 43): what OUTBOUND_HTTP lets this
                    instance reach. SMTP is not HTTP and is not governed by it.
                #}
                <dt>{{ t('settings.status_outbound') }}</dt>
                <dd>
                    <span class="badge {{ outbound_mode == 'open' ? 'badge-ok' : 'badge-warn' }}">{{ t('settings.outbound_' ~ outbound_mode) }}</span>
                    <span class="muted block">{{ t('settings.outbound_' ~ outbound_mode ~ '_hint', {'variable': 'OUTBOUND_HTTP'}) }}</span>
                </dd>

                <dt>{{ t('settings.status_metrics') }}</dt>
                <dd>
                    {% if metrics_enabled %}
                        <span class="badge badge-ok">{{ t('state.on') }}</span>
                        <span class="muted block">{{ t('settings.status_metrics_on') }}</span>
                    {% else %}
                        <span class="badge">{{ t('state.off') }}</span>
                        <span class="muted block">{{ t('settings.status_metrics_off', {'variable': 'METRICS_TOKEN'}) }}</span>
                    {% endif %}
                </dd>

                <dt>{{ t('settings.status_secrets_key') }}</dt>
                <dd>
                    {% if secrets_key_set %}
                        <span class="badge badge-ok">{{ t('settings.status_secrets_key_set') }}</span>
                        <span class="muted block">{{ t('settings.status_secrets_key_set_hint') }}</span>
                    {% else %}
                        <span class="badge badge-warn">{{ t('settings.status_secrets_key_unset') }}</span>
                        <span class="muted block">{{ t('settings.status_secrets_key_unset_hint', {'variable': 'SECRETS_KEY', 'session': 'SESSION_KEY'}) }}</span>
                    {% endif %}
                </dd>

                {#
                    API token lifetimes (Phase 42): the maximum, if there is
                    one, and how many live tokens still never expire — a
                    maximum binds only the tokens issued after it.
                #}
                <dt>{{ t('settings.status_api_tokens') }}</dt>
                <dd>
                    {% if token_max_days %}
                        <span>{{ t('settings.status_api_tokens_max', {'count': token_max_days, 'variable': 'API_TOKEN_MAX_DAYS'}) }}</span>
                    {% else %}
                        <span class="muted">{{ t('settings.status_api_tokens_no_max') }}</span>
                    {% endif %}
                    <span class="muted block">
                        {{ t('settings.status_api_tokens_without_expiry', {'count': tokens_without_expiry}) }}
                        {%- if token_max_days and tokens_without_expiry > 0 %} {{ t('settings.status_api_tokens_outstanding') }}
                        {%- elseif not token_max_days %} {{ t('settings.status_api_tokens_set_max', {'variable': 'API_TOKEN_MAX_DAYS'}) }}{% endif %}
                    </span>
                </dd>

                <dt>{{ t('settings.status_scheduler') }}</dt>
                <dd>
                    {% if scheduler_last_run_at %}
                        <span class="num">{{ scheduler_last_run_at|local_date('d MMM y, HH:mm') }}</span>
                    {% else %}
                        <span class="muted">{{ t('settings.status_scheduler_never') }}</span>
                    {% endif %}
                </dd>

                <dt>{{ t('settings.status_instance_backup') }}</dt>
                <dd>
                    {% if backups.last_verified %}
                        <a class="num" href="#instance-backups">{{ backups.last_verified.startedAt|local_date('d MMM y, HH:mm') }}</a>
                    {% elseif backups.key_state == 'ok' %}
                        <span class="muted">{{ t('settings.status_instance_backup_never') }}</span>
                    {% elseif backups.key_state == 'invalid' %}
                        <span class="muted">{{ t('settings.status_instance_backup_bad_key', {'variable': 'BACKUP_ENCRYPTION_KEY'}) }}</span>
                    {% else %}
                        <span class="muted">{{ t('settings.status_instance_backup_no_key', {'variable': 'BACKUP_ENCRYPTION_KEY'}) }}</span>
                    {% endif %}
                </dd>
            </dl>
        </section>
    </div>

    {#
        Instance backups (Phase 38): the whole database and every stored
        file, encrypted under BACKUP_ENCRYPTION_KEY. The key is shown by its
        fingerprint and never otherwise; without it the controls are drawn
        disabled and the card says what to set. There is no restore here —
        that is `bin/console backup:restore`, on purpose.
    #}
    {% set backup_ready = backups.key_state == 'ok' %}
    <section class="card" id="instance-backups" aria-labelledby="instance-backups-heading">
        <h2 id="instance-backups-heading">{{ t('backup.instance_heading') }}</h2>
        <p class="muted">{{ t('backup.instance_intro') }}</p>

        {% if backups.local_only %}
            <p class="alert callout instance-backup-warning" role="note">
                {{ icon('warn') }}{{ t('backup.instance_same_server', {'variable': 'BACKUP_DIRECTORY'}) }}
            </p>
        {% elseif backups.stale %}
            <p class="alert callout instance-backup-warning" role="note">
                {{ icon('warn') }}{{ t('backup.instance_offsite_stale') }}
            </p>
        {% endif %}

        <dl class="settings-facts">
            <dt>{{ t('backup.instance_key') }}</dt>
            <dd>
                {% if backup_ready %}
                    <span class="num">{{ backups.fingerprint }}</span>
                    <span class="badge badge-ok">{{ t('backup.instance_key_set') }}</span>
                    <span class="muted block">{{ t('backup.instance_keys_elsewhere', {
                        'backup': 'BACKUP_ENCRYPTION_KEY',
                        'session': 'SESSION_KEY',
                        'secrets': 'SECRETS_KEY',
                        'previous': 'SECRETS_PREVIOUS_KEYS',
                        'totp': 'TOTP_ENCRYPTION_KEY',
                    }) }}</span>
                {% elseif backups.key_state == 'invalid' %}
                    <span class="badge badge-bad">{{ t('backup.instance_key_invalid') }}</span>
                    <span class="muted block">{{ t('backup.instance_key_invalid_hint', {'variable': 'BACKUP_ENCRYPTION_KEY'}) }}</span>
                {% else %}
                    <span class="badge badge-warn">{{ t('backup.instance_key_missing') }}</span>
                    <span class="muted block">{{ t('backup.instance_key_missing_hint', {'variable': 'BACKUP_ENCRYPTION_KEY'}) }}</span>
                {% endif %}
            </dd>

            <dt>{{ t('backup.instance_directory') }}</dt>
            <dd><code>{{ backups.directory }}</code></dd>
        </dl>

        <form method="post" action="/settings/backups" class="stack">
            {{ csrf_field() }}

            <fieldset class="role-options" id="backup-schedule" {{ backup_ready ? '' : 'disabled' }}>
                <legend>{{ t('backup.instance_schedule') }}</legend>
                {% for schedule in backups.schedules %}
                    <label class="role-option">
                        <input type="radio" name="schedule" value="{{ schedule.value }}"
                               {{ backups.schedule == schedule.value ? 'checked' : '' }}>
                        <span class="role-option-text">{{ t(schedule.labelKey()) }}</span>
                    </label>
                {% endfor %}
            </fieldset>

            <fieldset class="stack" id="backup-retention" {{ backup_ready ? '' : 'disabled' }}>
                <legend>{{ t('backup.instance_retention') }}</legend>
                <p class="hint">{{ t('backup.instance_retention_hint') }}</p>
                <div class="field-grid field-grid-3">
                    {% for field in ['daily', 'weekly', 'monthly'] %}
                        <div class="field">
                            <label for="keep-{{ field }}">{{ t('backup.instance_keep_' ~ field) }}</label>
                            <input type="number" id="keep-{{ field }}" name="keep_{{ field }}" class="num"
                                   min="0" max="{{ backups.max_retention }}" required
                                   value="{{ attribute(backups.retention, field) }}">
                        </div>
                    {% endfor %}
                </div>
            </fieldset>

            <div class="form-actions">
                <button type="submit" class="button button-outline" {{ backup_ready ? '' : 'disabled' }}>{{ t('backup.instance_save') }}</button>
            </div>
        </form>

        <form method="post" action="/settings/backups/run" class="form-actions">
            {{ csrf_field() }}
            <button type="submit" class="button button-primary" {{ backup_ready ? '' : 'disabled' }}>
                {{- icon('lock') }}{{ t('backup.instance_back_up_now') -}}
            </button>
            <span class="hint">{{ t(backups.destinations is empty ? 'backup.instance_back_up_now_hint' : 'backup.instance_back_up_now_hint_offsite') }}</span>
        </form>

        <h3 class="instance-backup-history-heading">{{ t('backup.instance_history') }}</h3>
        {% if backups.history is empty %}
            <p class="muted empty">{{ t('backup.instance_history_empty') }}</p>
        {% else %}
            <ul class="account-rows instance-backup-rows">
                {% for item in backups.history %}
                    {% set run = item.run %}
                    <li class="account-row">
                        <span class="account-row-icon" aria-hidden="true">{{ icon(run.status == 'failed' ? 'warn' : 'lock') }}</span>
                        <div class="account-row-text">
                            <span class="account-row-name">
                                <span class="num">{{ run.startedAt|local_date('d MMM y, HH:mm') }}</span>
                                {% if run.status == 'verified' %}
                                    <span class="badge badge-ok">{{ t('backup.status.verified') }}</span>
                                    {% if item.offsite == 'stored' %}
                                        <span class="badge badge-ok">{{ t('backup.instance_stored_offsite') }}</span>
                                    {% elseif item.offsite == 'sending' %}
                                        <span class="badge badge-info">{{ t('backup.instance_sending') }}</span>
                                    {% elseif item.offsite == 'local' %}
                                        <span class="badge badge-warn">{{ t('backup.instance_verified_locally') }}</span>
                                    {% endif %}
                                {% elseif run.status == 'failed' %}
                                    <span class="badge badge-bad">{{ t('backup.status.failed') }}</span>
                                {% else %}
                                    <span class="badge badge-info">{{ t('backup.status.running') }}</span>
                                {% endif %}
                                {% if run.prunedAt %}<span class="badge">{{ t('backup.status.pruned') }}</span>{% endif %}
                            </span>
                            <span class="account-row-meta">
                                {{ t('backup.trigger.' ~ run.trigger) }}
                                {%- if run.durationSeconds() is not null %} · <span class="num">{{ t('backup.duration', {'seconds': run.durationSeconds()}) }}</span>{% endif %}
                                {%- if item.size %} · <span class="num">{{ t(item.size.key, {'size': item.size.value|decimal(item.size.digits)}) }}</span>{% endif %}
                                {%- if run.keyFingerprint %} · {{ t('backup.key_short') }} <span class="num">{{ run.keyFingerprint }}</span>{% endif %}
                            </span>
                            {% if run.status == 'failed' %}
                                <span class="account-row-meta instance-backup-error">{{ t('backup.reason.' ~ (run.error ?? 'unexpected')) }}</span>
                            {% endif %}
                            {% if item.copies is not empty %}
                                <span class="account-row-meta instance-backup-copies">
                                    {{ t('backup.history_offsite') }}:
                                    {% for copy in item.copies %}
                                        {{- copy.name ?? t('backup.copy.removed_destination') }} — {{ t('backup.copy.' ~ copy.status) }}{{ loop.last ? '' : ' · ' -}}
                                    {% endfor %}
                                </span>
                            {% endif %}
                            {% if run.warnings is not empty %}
                                <details class="instance-backup-warnings">
                                    <summary class="account-row-meta">{{ t('backup.warnings', {'count': run.warningCount()}) }}</summary>
                                    <ul class="hint">
                                        {% for warning in run.warnings %}
                                            <li>{{ t('backup.warning.' ~ warning.code) }} <code>{{ warning.detail }}</code></li>
                                        {% endfor %}
                                    </ul>
                                </details>
                            {% endif %}
                        </div>
                        {% if run.isAvailable() %}
                            <div class="account-row-actions">
                                <a class="button button-quiet" href="/settings/backups/{{ run.id }}/download" download
                                   aria-label="{{ t('backup.download_named', {'date': run.startedAt|local_date('d MMM y, HH:mm')}) }}">
                                    {{- icon('download') }}{{ t('action.download') -}}
                                </a>
                            </div>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    {#
        Destinations (Phase 39): every verified backup is sent to each one
        that is switched on, encrypted before it leaves. Credentials are
        written once and never drawn again — the form says only that one is
        set. Removing one forgets it; what it holds stays there.
    #}
    <section class="card" id="backup-destinations" aria-labelledby="backup-destinations-heading">
        <h2 id="backup-destinations-heading">{{ t('backup.destination.heading') }}</h2>
        <p class="muted">{{ t('backup.destination.intro') }}</p>

        {% if backups.destinations is empty %}
            <p class="muted empty">{{ t('backup.destination.none') }}</p>
        {% else %}
            <ul class="account-rows channel-rows destination-rows">
                {% for item in backups.destinations %}
                    {% set destination = item.record %}
                    {% set edit = destination_edit is defined and destination_edit and destination_edit.id == destination.id ? destination_edit : null %}
                    <li class="account-row channel-row{{ destination.enabled ? '' : ' is-off' }}">
                        <span class="account-row-icon" aria-hidden="true">{{ icon(destination.type.icon()) }}</span>
                        <div class="account-row-text">
                            <span class="account-row-name">{{ destination.name }}</span>
                            <span class="account-row-meta">{{ t(destination.type.labelKey()) }} · {{ t('backup.destination.id', {'id': destination.id}) }} · <code>{{ destination.location() }}</code></span>
                            <span class="account-row-meta">
                                {%- if item.last_upload -%}
                                    {{ t('backup.destination.last_upload', {'date': item.last_upload|local_date('d MMM y, HH:mm')}) }}
                                {%- else -%}
                                    {{ t('backup.destination.never_uploaded') }}
                                {%- endif %} · {{ t('backup.destination.retention', {
                                    'daily': destination.retention.daily,
                                    'weekly': destination.retention.weekly,
                                    'monthly': destination.retention.monthly,
                                }) }}
                            </span>
                            {% if destination.secretsUnreadable %}
                                <span class="field-error">{{ t('backup.destination.credentials_unreadable') }}</span>
                            {% endif %}
                        </div>
                        <div class="account-row-actions">
                            <form method="post" action="/settings/backups/destinations/{{ destination.id }}/enabled"
                                  class="inline channel-switch"
                                  hx-post="/settings/backups/destinations/{{ destination.id }}/enabled" hx-trigger="change">
                                {{ csrf_field() }}
                                <input type="hidden" name="enabled" value="0">
                                <input type="checkbox" class="toggle" role="switch" name="enabled" value="1"
                                       aria-label="{{ t('backup.destination.enabled_named', {'name': destination.name}) }}"
                                       {{ destination.enabled ? 'checked' : '' }}>
                                <noscript>
                                    <button type="submit" class="button button-quiet">{{ t('action.save') }}</button>
                                </noscript>
                            </form>
                        </div>

                        <details class="account-row-more" {{ edit ? 'open' : '' }}>
                            <summary class="button button-quiet">{{ icon('edit') }}{{ t('backup.destination.edit_named', {'name': destination.name}) }}</summary>

                            <form method="post" action="/settings/backups/destinations/{{ destination.id }}" class="stack">
                                {{ csrf_field() }}

                                <label for="destination_{{ destination.id }}_name">{{ t('backup.destination.field.name') }}</label>
                                <input type="text" id="destination_{{ destination.id }}_name" name="name" value="{{ edit ? edit.values.name|default('') : destination.name }}" required maxlength="100">
                                {% if edit and edit.errors.name is defined %}<p class="field-error">{{ error_message(edit.errors.name) }}</p>{% endif %}

                                {% for field in destination.type.fields() %}
                                    {% set id = 'destination_' ~ destination.id ~ '_' ~ field.name %}
                                    {% if field.input == 'checkbox' %}
                                        <input type="hidden" name="{{ field.name }}" value="0">
                                        <label class="choice toggle-row" for="{{ id }}">
                                            <span>
                                                <span class="choice-title">{{ t('backup.destination.field.' ~ field.name) }}</span>
                                                {% if field.hint %}<span class="choice-note">{{ t('backup.destination.field.' ~ field.name ~ '_hint') }}</span>{% endif %}
                                            </span>
                                            <input type="checkbox" class="toggle" role="switch" id="{{ id }}" name="{{ field.name }}" value="1"
                                                   {{ (edit ? edit.values[field.name]|default('') == '1' : destination.configBool(field.name)) ? 'checked' : '' }}>
                                        </label>
                                    {% else %}
                                        <label for="{{ id }}">{{ t('backup.destination.field.' ~ field.name) }}</label>
                                        {% if field.secret %}
                                            <p class="hint">
                                                {% if destination.hasSecret(field.name) %}<span class="badge badge-ok">{{ t('backup.destination.credential_set') }}</span>{% endif %}
                                                {{ t('backup.destination.credential_replace_hint') }}
                                            </p>
                                            <input type="password" id="{{ id }}" name="{{ field.name }}" autocomplete="off"
                                                   placeholder="{{ t('backup.destination.credential_replace') }}">
                                        {% else %}
                                            <input type="{{ field.input }}" id="{{ id }}" name="{{ field.name }}" autocomplete="off"
                                                   {{ field.required ? 'required' : '' }}
                                                   value="{{ edit ? edit.values[field.name]|default('') : destination.configString(field.name) }}">
                                            {% if field.hint %}<p class="hint">{{ t('backup.destination.field.' ~ field.name ~ '_hint') }}</p>{% endif %}
                                        {% endif %}
                                    {% endif %}
                                    {% if edit and edit.errors[field.name] is defined %}
                                        <p class="field-error">{{ error_message(edit.errors[field.name]) }}</p>
                                    {% endif %}
                                {% endfor %}

                                <fieldset class="stack destination-retention">
                                    <legend>{{ t('backup.instance_retention') }}</legend>
                                    <p class="hint">{{ t('backup.destination.retention_hint') }}</p>
                                    <div class="field-grid field-grid-3">
                                        {% for period in ['daily', 'weekly', 'monthly'] %}
                                            <div class="field">
                                                <label for="destination_{{ destination.id }}_keep_{{ period }}">{{ t('backup.instance_keep_' ~ period) }}</label>
                                                <input type="number" id="destination_{{ destination.id }}_keep_{{ period }}" name="keep_{{ period }}" class="num"
                                                       min="0" max="{{ backups.max_retention }}" required
                                                       value="{{ edit ? edit.values['keep_' ~ period]|default(attribute(destination.retention, period)) : attribute(destination.retention, period) }}">
                                            </div>
                                        {% endfor %}
                                    </div>
                                </fieldset>

                                <div class="form-actions">
                                    <button type="submit" class="button">{{ t('backup.destination.save') }}</button>
                                </div>
                            </form>

                            <div class="form-actions">
                                <form method="post" action="/settings/backups/destinations/{{ destination.id }}/test" class="inline">
                                    {{ csrf_field() }}
                                    <button type="submit" class="button button-quiet"
                                            aria-label="{{ t('backup.destination.test_named', {'name': destination.name}) }}">
                                        {{- icon('refresh') }}{{ t('backup.destination.test') -}}
                                    </button>
                                </form>
                                <form method="post" action="/settings/backups/destinations/{{ destination.id }}/delete" class="inline"
                                      data-confirm="{{ t('backup.destination.remove_confirm', {'name': destination.name}) }}">
                                    {{ csrf_field() }}
                                    <button type="submit" class="button button-danger"
                                            aria-label="{{ t('backup.destination.remove_named', {'name': destination.name}) }}">{{ t('backup.destination.remove') }}</button>
                                </form>
                            </div>
                        </details>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {% set failed = destination_form ?? null %}
        <details class="settings-disclosure" id="add-destination" {{ failed ? 'open' : '' }}>
            <summary class="button button-outline">{{ icon('add') }}{{ t('backup.destination.add') }}</summary>
            {% if failed and failed.errors.type is defined %}<p class="field-error">{{ error_message(failed.errors.type) }}</p>{% endif %}

            {% for type in backups.destination_types %}
                {% set is_this = failed and failed.type == type.value %}
                <details class="channel-form" {{ is_this ? 'open' : '' }}>
                    <summary>{{ icon(type.icon()) }}{{ t(type.labelKey()) }}</summary>

                    <form method="post" action="/settings/backups/destinations" class="stack">
                        {{ csrf_field() }}
                        <input type="hidden" name="type" value="{{ type.value }}">

                        <label for="new_{{ type.value }}_name">{{ t('backup.destination.field.name') }}</label>
                        <input type="text" id="new_{{ type.value }}_name" name="name" required maxlength="100"
                               placeholder="{{ t(type.labelKey()) }}"
                               value="{{ is_this ? failed.values.name|default('') : '' }}">
                        {% if is_this and failed.errors.name is defined %}<p class="field-error">{{ error_message(failed.errors.name) }}</p>{% endif %}

                        {% for field in type.fields() %}
                            {% set id = 'new_' ~ type.value ~ '_' ~ field.name %}
                            {% if field.input == 'checkbox' %}
                                <input type="hidden" name="{{ field.name }}" value="0">
                                <label class="choice toggle-row" for="{{ id }}">
                                    <span>
                                        <span class="choice-title">{{ t('backup.destination.field.' ~ field.name) }}</span>
                                        {% if field.hint %}<span class="choice-note">{{ t('backup.destination.field.' ~ field.name ~ '_hint') }}</span>{% endif %}
                                    </span>
                                    <input type="checkbox" class="toggle" role="switch" id="{{ id }}" name="{{ field.name }}" value="1"
                                           {{ is_this and failed.values[field.name]|default('') == '1' ? 'checked' : '' }}>
                                </label>
                            {% else %}
                                <label for="{{ id }}">{{ t('backup.destination.field.' ~ field.name) }}</label>
                                <input type="{{ field.input }}" id="{{ id }}" name="{{ field.name }}" autocomplete="off"
                                       {{ field.required ? 'required' : '' }}
                                       {% if is_this and not field.secret %}value="{{ failed.values[field.name]|default('') }}"{% endif %}>
                                {% if field.hint %}<p class="hint">{{ t('backup.destination.field.' ~ field.name ~ '_hint') }}</p>{% endif %}
                            {% endif %}
                            {% if is_this and failed.errors[field.name] is defined %}
                                <p class="field-error">{{ error_message(failed.errors[field.name]) }}</p>
                            {% endif %}
                        {% endfor %}

                        <p class="hint">{{ t('backup.destination.retention_hint') }}
                            {{ t('backup.destination.retention', {
                                'daily': backups.retention.daily,
                                'weekly': backups.retention.weekly,
                                'monthly': backups.retention.monthly,
                            }) }}</p>

                        <div class="form-actions">
                            <button type="submit" class="button">{{ t('backup.destination.add') }}</button>
                        </div>
                    </form>
                </details>
            {% endfor %}
        </details>
    </section>

    {#
        The restore rehearsal (Phase 39): how often, whether a scratch
        database is configured, and how the last ones went. It runs from the
        scheduler (`backup:rehearse`); there is no button, because a restore
        into the scratch database outlasts any page.
    #}
    <section class="card" id="backup-rehearsal" aria-labelledby="backup-rehearsal-heading">
        <h2 id="backup-rehearsal-heading">{{ t('backup.rehearsal.heading') }}</h2>
        <p class="muted">{{ t('backup.rehearsal.intro') }}</p>

        {% set rehearsal = backups.rehearsal %}
        <dl class="settings-facts">
            <dt>{{ t('backup.rehearsal.database') }}</dt>
            <dd>
                {% if rehearsal.scratch %}
                    <span class="badge badge-ok">{{ t('backup.rehearsal.database_configured') }}</span>
                    <span class="muted block">{{ t('backup.rehearsal.database_set') }}</span>
                {% else %}
                    <span class="muted">{{ t('backup.rehearsal.database_missing', {'variable': 'BACKUP_REHEARSAL_DB_NAME'}) }}</span>
                {% endif %}
            </dd>

            <dt>{{ t('backup.rehearsal.last') }}</dt>
            <dd>
                {% if rehearsal.last %}
                    <span class="num">{{ rehearsal.last.startedAt|local_date('d MMM y, HH:mm') }}</span>
                    <span class="badge {{ rehearsal.last.passed() ? 'badge-ok' : (rehearsal.last.status == 'failed' ? 'badge-bad' : 'badge-info') }}">
                        {{- t('backup.rehearsal.status.' ~ rehearsal.last.status) -}}
                    </span>
                {% elseif not rehearsal.has_destination %}
                    <span class="muted">{{ t('backup.rehearsal.no_destination') }}</span>
                {% else %}
                    <span class="muted">{{ t('backup.rehearsal.never') }}</span>
                {% endif %}
            </dd>
        </dl>

        <form method="post" action="/settings/backups/rehearsal" class="stack">
            {{ csrf_field() }}
            <fieldset class="role-options" id="rehearsal-schedule">
                <legend>{{ t('backup.rehearsal.schedule') }}</legend>
                {% for schedule in rehearsal.schedules %}
                    <label class="role-option">
                        <input type="radio" name="rehearsal_schedule" value="{{ schedule.value }}"
                               {{ rehearsal.schedule == schedule.value ? 'checked' : '' }}>
                        <span class="role-option-text">{{ t(schedule.labelKey()) }}</span>
                    </label>
                {% endfor %}
            </fieldset>
            <div class="form-actions">
                <button type="submit" class="button button-outline">{{ t('backup.rehearsal.save') }}</button>
            </div>
        </form>

        {% if rehearsal.history is not empty %}
            <h3 class="instance-backup-history-heading">{{ t('backup.rehearsal.history') }}</h3>
            <ul class="account-rows instance-backup-rows">
                {% for item in rehearsal.history %}
                    <li class="account-row">
                        <span class="account-row-icon" aria-hidden="true">{{ icon(item.status == 'failed' ? 'warn' : 'rehearsal') }}</span>
                        <div class="account-row-text">
                            <span class="account-row-name">
                                {% if item.startedAt %}<span class="num">{{ item.startedAt|local_date('d MMM y, HH:mm') }}</span>{% endif %}
                                <span class="badge {{ item.passed() ? 'badge-ok' : (item.status == 'failed' ? 'badge-bad' : 'badge-info') }}">
                                    {{- t('backup.rehearsal.status.' ~ item.status) -}}
                                </span>
                            </span>
                            <span class="account-row-meta">{{ item.destinationName ?? t('backup.copy.removed_destination') }} · {{ t('backup.rehearsal.kind.' ~ item.kind) }}</span>
                            {% if item.status == 'failed' %}
                                <span class="account-row-meta instance-backup-error">
                                    {{- t('backup.rehearsal.step.' ~ (item.step ?? 'unknown')) }}: {{ t(item.errorKey()) -}}
                                </span>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="card" id="trusted-hosts" aria-labelledby="trusted-hosts-heading">
        <h2 id="trusted-hosts-heading">{{ t('settings.trusted_hosts') }}</h2>

        <p class="muted note">{{ t('settings.trusted_hosts_intro') }}</p>
        <p class="muted note">{{ t('settings.trusted_hosts_exception') }} <code>http</code>.</p>

        {% if trusted_hosts is empty %}
            <p class="muted empty">{{ t('settings.trusted_hosts_empty') }}</p>
        {% else %}
            <div class="table-scroll">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">{{ t('settings.host_or_range') }}</th>
                        <th scope="col">{{ t('settings.trusted_kind') }}</th>
                        <th scope="col">{{ t('field.note') }}</th>
                        <th scope="col">{{ t('field.added') }}</th>
                        <th scope="col"><span class="visually-hidden">{{ t('field.actions') }}</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for host in trusted_hosts %}
                        <tr>
                            <td><code>{{ host.pattern }}</code></td>
                            <td>{{ t('settings.trusted_kind_' ~ host.kind.value) }}</td>
                            <td>{{ host.note }}</td>
                            <td class="num">
                                {{ host.created_at|local_date('d MMM y') }}
                                {% if host.created_by %}<span class="muted">{{ t('settings.added_by', {'name': host.created_by}) }}</span>{% endif %}
                            </td>
                            <td class="actions">
                                <form method="post" action="/settings/trusted-hosts/{{ host.id }}/delete" class="inline">
                                    {{ csrf_field() }}
                                    <button type="submit" class="button button-quiet"
                                            aria-label="{{ t('settings.remove_named', {'name': host.pattern}) }}">{{ t('action.remove') }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <form method="post" action="/settings/trusted-hosts" class="stack">
            {{ csrf_field() }}

            <label for="trusted_pattern">{{ t('settings.host_address_or_range') }}</label>
            <input type="text" id="trusted_pattern" name="pattern"
                   placeholder="{{ t('settings.trusted_host_placeholder') }}" required>

            <label for="trusted_kind">{{ t('settings.trusted_kind') }}</label>
            <select id="trusted_kind" name="kind" aria-describedby="trusted_kind-hint">
                <option value="private">{{ t('settings.trusted_kind_private') }}</option>
                <option value="contact">{{ t('settings.trusted_kind_contact') }}</option>
            </select>
            <p class="muted note" id="trusted_kind-hint">{{ t('settings.trusted_kind_hint') }}</p>

            <label for="trusted_note">{{ t('field.note') }}</label>
            <input type="text" id="trusted_note" name="note" placeholder="{{ t('settings.trusted_host_note_placeholder') }}">

            <div class="form-actions">
                <button type="submit" class="button button-outline">{{ t('settings.trust_this_host') }}</button>
            </div>
        </form>
    </section>
{% endblock %}
