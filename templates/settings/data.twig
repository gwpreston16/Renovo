{% extends 'layout.twig' %}

{% block heading %}{{ t('nav.settings') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.settings') }}{% endblock %}

{#
    Settings — Data & integrations: moving the household's data in and out,
    the keys other programs use, and what has been happening.

    Every member can open it: API tokens are each person's own and need no
    permission. Everything else is drawn for whoever may use it —
    import for `data.import`, backup and restore for `backup.manage`, recent
    activity for `audit.view` — and each route asks again.

    `SettingsController::data()` renders it. The screens that were Backup and
    API tokens redirect to their sections here, which is why each carries a
    fixed id.
#}
{% block content %}
    {% include 'settings/_tabs.twig' with {'tab': 'data'} %}

    {% if issued_token %}
        <section class="card callout" id="new-token" aria-labelledby="new-token-heading">
            <h2 id="new-token-heading">{{ t('tokens.your_new_token') }}</h2>
            <p>{{ t('tokens.new_token_note') }}</p>
            <p><code class="token">{{ issued_token }}</code></p>
        </section>
    {% endif %}

    <div class="settings-grid">
        {% if can(scope, 'data.import') %}
            <section class="card" id="import" aria-labelledby="import-heading">
                <h2 id="import-heading">{{ t('nav.import') }}</h2>
                {#
                    The prototype's drop zone, as a link into the existing
                    wizard: the first step is where the file is chosen, and it
                    is a page because it has to be one without script.
                #}
                <a class="drop-link" href="/import">
                    {{ icon('upload', 'drop-link-icon') }}
                    <span class="drop-link-title">{{ t('settings.import_title') }}</span>
                    <span class="drop-link-note">{{ t('settings.import_note') }}</span>
                </a>
            </section>
        {% endif %}

        {% if can(scope, 'backup.manage') %}
            <section class="card" id="backup" aria-labelledby="backup-heading">
                <h2 id="backup-heading">{{ t('settings.backup_heading') }}</h2>
                <p class="muted">{{ t('backup.export_intro') }}</p>
                <p class="hint">{{ t('backup.export_scope') }} {{ t('backup.export_exclusions') }}</p>

                {% if private_left_out > 0 %}
                    <p class="hint" data-private-left-out="{{ private_left_out }}">
                        {{ t('backup.private_left_out', {'count': private_left_out}) }}
                    </p>
                {% endif %}

                <form method="post" action="/settings/backup/export" class="form-actions">
                    {{ csrf_field() }}
                    <button type="submit" class="button button-primary">{{ icon('download') }}{{ t('backup.download_backup') }}</button>
                </form>

                <details class="settings-disclosure">
                    <summary class="button button-outline">{{ t('settings.restore_from_file') }}</summary>

                    <p class="hint">{{ t('backup.restore_is_additive') }} {{ t('backup.restore_matching') }}</p>

                    <form method="post" action="/settings/backup/restore" enctype="multipart/form-data" class="stack"
                          data-confirm="{{ t('confirm.restore_backup') }}">
                        {{ csrf_field() }}

                        <label for="restore-archive">{{ t('backup.archive_label', {'version': backup_format_version}) }}</label>
                        <input type="file" id="restore-archive" name="archive" accept=".zip,application/zip" required>

                        <div class="form-actions">
                            <button type="submit" class="button">{{ t('backup.restore') }}</button>
                        </div>
                    </form>
                </details>
            </section>
        {% endif %}

        {% if can(scope, 'subscription.view') %}
            <section class="card" id="export" aria-labelledby="export-heading">
                <h2 id="export-heading">{{ t('settings.export_heading') }}</h2>
                <p class="muted">{{ t('settings.export_intro') }}</p>
                <div class="form-actions">
                    <a class="button button-outline" href="/subscriptions/export.csv" download>{{ icon('download') }}{{ t('settings.export_csv') }}</a>
                    <a class="button button-outline" href="/subscriptions/export.json" download>{{ icon('download') }}{{ t('settings.export_json') }}</a>
                </div>
                <p class="muted">{{ t('settings.export_payments_intro') }}</p>
                <div class="form-actions">
                    <a class="button button-outline" href="/payments/export.csv" download>{{ icon('download') }}{{ t('settings.export_payments_csv') }}</a>
                    <a class="button button-outline" href="/payments/export.json" download>{{ icon('download') }}{{ t('settings.export_payments_json') }}</a>
                </div>
            </section>
        {% endif %}

        {% include 'settings/_tokens.twig' %}

        {% if can(scope, 'audit.view') %}
            <section class="card" id="recent-activity" aria-labelledby="recent-activity-heading">
                <header class="card-header">
                    <h2 id="recent-activity-heading">{{ t('settings.recent_activity') }}</h2>
                    <a class="card-header-actions" href="/audit">{{ t('settings.full_audit_log') }}</a>
                </header>

                {% if recent_activity is empty %}
                    <p class="muted empty">{{ t('audit_entries.no_events_recorded') }}</p>
                {% else %}
                    <ul class="account-rows activity-rows">
                        {% for entry in recent_activity %}
                            <li class="account-row">
                                <div class="account-row-text">
                                    <span>
                                        <strong>{{ entry.actorName }}</strong>
                                        <span class="muted">{{ t(entry.action.labelKey()) }}
                                            {%- if entry.targetLabel and entry.targetUserId != entry.actorUserId %} → {{ entry.targetLabel }}{% endif %}</span>
                                    </span>
                                    <span class="account-row-meta num">{{ entry.occurredAt|local_date('d MMM y, HH:mm') }}</span>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endif %}
    </div>
{% endblock %}
