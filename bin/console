#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * CLI entry point.
 *
 * Commands are resolved against the same container the web application uses,
 * so a command and a controller can never be looking at different
 * configuration.
 *
 * `reminders:run` is the scheduler's entry point and is the command the
 * Docker scheduler container and a cron entry both call. It is safe to run more
 * often than daily and safe to run twice at once: every dispatch is claimed in
 * the notification ledger before it is sent, so a second run finds the work
 * already done rather than doing it again.
 */

use App\I18n\CatalogChecker;
use App\I18n\Translator;
use App\Persistence\PdoSessionHandler;
use App\Repository\AuditLogRepository;
use App\Repository\AuthAttemptRepository;
use App\Repository\NotificationLogRepository;
use App\Repository\TokenRepository;
use App\Service\Backup\BackupAlertService;
use App\Service\Backup\BackupException;
use App\Service\Backup\BackupRehearsalService;
use App\Service\Backup\Destination\DestinationException;
use App\Service\Backup\BackupOutcome;
use App\Service\Backup\InstanceBackupService;
use App\Service\Backup\InstanceRestoreService;
use App\Service\Backup\OffsiteBackupService;
use App\Service\DemoSeedService;
use App\Service\ExchangeRate\RateProviderException;
use App\Service\ExchangeRateService;
use App\Service\ImportService;
use App\Service\InstanceSettingsService;
use App\Service\LedgerBackfillRunner;
use App\Service\Notification\ReminderRunner;
use App\Service\SecretsRotationService;
use App\Service\Update\CheckNowResult;
use App\Service\Update\UpdateCheckService;
use App\Support\Clock;
use App\Support\CoverageFloor;
use App\Support\ExternalAssetScanner;
use Psr\Container\ContainerInterface;
use Slim\App;

require __DIR__ . '/../vendor/autoload.php';

/** @var callable(bool): App $bootstrap */
$bootstrap = require __DIR__ . '/../config/bootstrap.php';

$app = $bootstrap(false);
$container = $app->getContainer();

if (!$container instanceof ContainerInterface) {
    fwrite(STDERR, "The application has no container.\n");
    exit(1);
}

$command = $argv[1] ?? 'list';

/**
 * @param non-empty-string $message
 */
$out = static function (string $message): void {
    fwrite(STDOUT, $message . PHP_EOL);
};

switch ($command) {
    case 'reminders:run':
        // The scheduler's daily work: catch up each household's dates, find
        // what is due, dispatch it once, and re-evaluate every budget.
        $totals = $container->get(ReminderRunner::class)->run();

        // Recorded after the run, not before: the readiness endpoint reports
        // when the scheduler last *finished*, and a run that died halfway
        // through should not look like a healthy one.
        $container->get(InstanceSettingsService::class)
            ->markSchedulerRun($container->get(Clock::class)->now());

        // Its own step, after the reminders: whether a newer release is out,
        // when checks are on and a day has passed. It logs and swallows its
        // own failures, so GitHub being down never fails the reminder run.
        $container->get(UpdateCheckService::class)->refreshIfDue();

        $out(sprintf(
            'Checked %d user(s); %d alert(s) found, %d message(s) sent.',
            $totals['users'],
            $totals['alerts'],
            $totals['sent'],
        ));

        if ($totals['failures'] > 0) {
            // Non-zero so a scheduler can tell a run that partly failed from a
            // clean one, without the failure stopping the users who were fine.
            fwrite(STDERR, sprintf("%d user(s) could not be processed; see the log.\n", $totals['failures']));
            exit(1);
        }

        exit(0);

    case 'rates:refresh':
        // Kept as its own command rather than folded into the reminder run:
        // an instance should be able to keep its rates current without
        // depending on somebody loading a page, and a provider outage should
        // not be able to fail the reminder run.
        $rates = $container->get(ExchangeRateService::class);

        try {
            $count = $rates->refresh();
        } catch (RateProviderException $exception) {
            // A non-zero exit so the scheduler can tell a failed refresh from a
            // successful one, without the failure being fatal to anything else.
            fwrite(STDERR, 'Exchange-rate refresh failed: ' . $exception->getMessage() . PHP_EOL);
            exit(1);
        }

        $out(sprintf('Cached %d rate(s) from %s.', $count, $rates->provider()->label()));
        exit(0);

    case 'updates:check':
        // The scheduler's update check, run now whenever the last one was.
        // With checks off it says so and asks nothing of GitHub.
        $updates = $container->get(UpdateCheckService::class);
        $result = $updates->check();

        if ($result === CheckNowResult::Off) {
            $out('Update checks are disabled. Turn them on in Settings → Instance, or unset UPDATE_CHECK=false.');
            exit(0);
        }

        if ($result === CheckNowResult::Failed) {
            fwrite(STDERR, "The update check failed; see the log.\n");
            exit(1);
        }

        $status = $updates->status();
        $out($status->latestVersion === null
            ? 'No release has been published yet.'
            : sprintf('Latest release: %s. This is %s.', $status->latestVersion, $status->currentVersion));
        exit(0);

    case 'maintenance:prune':
        // Housekeeping that is genuinely needed now: expired sessions, spent
        // tokens and stale throttle records accumulate from day one.
        $clock = $container->get(Clock::class);

        $sessions = $container->get(PdoSessionHandler::class)->gc(0);
        $tokens = $container->get(TokenRepository::class)->purgeExpired();
        $attempts = $container->get(AuthAttemptRepository::class)
            ->purgeOlderThan($clock->now()->modify('-30 days'));

        // The notification ledger only has to remember long enough to suppress
        // a re-send, and an occurrence key in the past can never come round
        // again. Pruning it keeps the table from growing without limit on an
        // instance that has been running for years.
        $retention = (int) $container->get('settings')['notifications']['log_retention_days'];
        $notifications = $container->get(NotificationLogRepository::class)
            ->purgeOlderThan($clock->now()->modify(sprintf('-%d days', max(1, $retention))));

        // The audit log is evidence with a shelf life. Kept far longer than the
        // notification ledger — an operator is asked "who changed this?" months
        // after the fact — but not for ever.
        $auditRetention = (int) $container->get('settings')['audit']['retention_days'];
        $auditEntries = $container->get(AuditLogRepository::class)
            ->purgeOlderThan($clock->now()->modify(sprintf('-%d days', max(1, $auditRetention))));

        // An import that was uploaded and never finished leaves a file in the
        // staging directory. The importer clears its own on commit or cancel;
        // this catches the ones nobody came back for.
        $imports = $container->get(ImportService::class)->purgeStale();

        $out(sprintf(
            'Pruned %d expired session(s), %d expired token(s), %d old auth attempt(s), '
            . '%d notification record(s), %d audit entr(ies), %d abandoned import(s).',
            is_int($sessions) ? $sessions : 0,
            $tokens,
            $attempts,
            $notifications,
            $auditEntries,
            $imports,
        ));
        exit(0);

    case 'ledger:backfill':
        // Once, after upgrading to the payment ledger: rebuild the charges
        // from before it existed. Idempotent, and never overwrites a charge
        // the catch-up wrote or an amount a member entered; a payment added by
        // hand on a rebuilt date becomes that date's charge. A charge on an
        // offer that has no reference yet is given one (Phase 36).
        $householdId = null;
        foreach (array_slice($argv, 2) as $argument) {
            if (preg_match('/^--household=(\d+)$/', $argument, $match) === 1) {
                $householdId = (int) $match[1];
            } else {
                fwrite(STDERR, sprintf("Unknown option \"%s\". Usage: ledger:backfill [--household=ID]\n", $argument));
                exit(1);
            }
        }

        $totals = $container->get(LedgerBackfillRunner::class)->run($householdId);
        $out(sprintf(
            'Backfilled %d charge(s) on %d subscription(s) across %d household(s); filed %d invoice(s) against them;'
            . ' gave %d charge(s) on an offer the price they would otherwise have cost.',
            $totals['charges'],
            $totals['subscriptions'],
            $totals['households'],
            $totals['invoices'],
            $totals['references'],
        ));
        exit(0);

    case 'secrets:rotate':
        // After replacing SECRETS_KEY (the old key moved to
        // SECRETS_PREVIOUS_KEYS): re-encrypt every stored secret under the new
        // key. Idempotent; a value no key opens is left as it is and listed.
        $dryRun = false;
        foreach (array_slice($argv, 2) as $argument) {
            if ($argument === '--dry-run') {
                $dryRun = true;
            } else {
                fwrite(STDERR, sprintf("Unknown option \"%s\". Usage: secrets:rotate [--dry-run]\n", $argument));
                exit(1);
            }
        }

        $rotation = $container->get(SecretsRotationService::class);
        if (!$rotation->usesSecretsKey()) {
            fwrite(STDERR, 'SECRETS_KEY is not set, so stored secrets are encrypted under TOTP_ENCRYPTION_KEY or '
                . "SESSION_KEY. Set SECRETS_KEY so the session key can be rotated on its own.\n");
        }

        $failed = false;
        foreach ($rotation->rotate($dryRun) as $kind => $counts) {
            $out(sprintf(
                '%s: %d %s, %d already under the current key, %d unreadable%s',
                $kind,
                $counts['rotated'],
                $dryRun ? 'would be re-encrypted' : 're-encrypted',
                $counts['current'],
                count($counts['unreadable']),
                $counts['unreadable'] === [] ? '' : ' (ids ' . implode(', ', $counts['unreadable']) . ')',
            ));
            $failed = $failed || $counts['unreadable'] !== [];
        }

        if ($failed) {
            fwrite(STDERR, "Some values could not be opened by any configured key and were left as they are. "
                . "Add the key they were written under to SECRETS_PREVIOUS_KEYS and run this again.\n");
        }
        exit($failed ? 2 : 0);

    case 'backup:run':
        // The scheduler's instance backup: taken if one is due by the schedule
        // set in Settings → Instance, or now with --force. Quiet and successful
        // when backups are off, since the scheduler asks every day.
        //
        // Then, every pass whether or not a backup was due (Phase 39): one
        // attempt at every copy still to be sent off the server, and the
        // backup alerts for instance administrators.
        $force = false;
        foreach (array_slice($argv, 2) as $argument) {
            if ($argument === '--force') {
                $force = true;
            } else {
                fwrite(STDERR, sprintf("Unknown option \"%s\". Usage: backup:run [--force]\n", $argument));
                exit(1);
            }
        }

        $offsite = $container->get(OffsiteBackupService::class);
        $error = null;
        $outcome = null;
        try {
            $outcome = $container->get(InstanceBackupService::class)->runScheduled($force);
        } catch (BackupException $exception) {
            $error = $exception->getMessage();
        }

        if ($outcome?->result === BackupOutcome::VERIFIED && $outcome->run !== null) {
            $offsite->queue($outcome->run);
        }
        $sent = $offsite->sendPending();
        $container->get(BackupAlertService::class)->notify();

        $code = 0;
        if ($error !== null) {
            fwrite(STDERR, $error . PHP_EOL);
            $code = 1;
        } else {
            switch ($outcome?->result) {
                case BackupOutcome::OFF:
                    $out('Scheduled instance backups are off. Turn them on in Settings → Instance, or use --force.');
                    break;
                case BackupOutcome::NOT_DUE:
                    $out('No instance backup is due yet.');
                    break;
                case BackupOutcome::BUSY:
                    $out('Another instance backup is running. Nothing was started.');
                    break;
                case BackupOutcome::FAILED:
                    fwrite(STDERR, 'The instance backup failed: ' . $outcome->message . PHP_EOL);
                    $code = 1;
                    break;
                default:
                    $run = $outcome?->run;
                    $out(sprintf(
                        'Backed up and verified: %s (%s bytes, key %s); %d warning(s); %d old backup(s) pruned.',
                        $run?->file,
                        number_format((int) $run?->sizeBytes),
                        $run?->keyFingerprint,
                        $run?->warningCount() ?? 0,
                        $outcome?->pruned ?? 0,
                    ));
            }
        }

        if (array_sum($sent) > 0) {
            $out(sprintf(
                'Off the server: %d copy(ies) confirmed, %d to retry, %d given up on; %d old copy(ies) pruned.',
                $sent['confirmed'],
                $sent['retrying'],
                $sent['failed'],
                $sent['pruned'],
            ));
        }
        exit($code);

    case 'backup:rehearse':
        // Phase 39: download the newest copy from a destination, verify it,
        // and — given BACKUP_REHEARSAL_DB_* — restore it into that empty
        // database, check it and empty it again. When one is due by the
        // schedule in Settings → Instance, or now with --force.
        $force = false;
        foreach (array_slice($argv, 2) as $argument) {
            if ($argument === '--force') {
                $force = true;
            } else {
                fwrite(STDERR, sprintf("Unknown option \"%s\". Usage: backup:rehearse [--force]\n", $argument));
                exit(1);
            }
        }

        $rehearsal = $container->get(BackupRehearsalService::class)->run($force);
        $container->get(BackupAlertService::class)->notify();

        if ($rehearsal === null) {
            $out($force
                ? 'Nothing to rehearse: no enabled destination holds a confirmed copy yet.'
                : 'No restore rehearsal is due.');
            exit(0);
        }

        if (!$rehearsal->passed()) {
            fwrite(STDERR, sprintf(
                "The restore rehearsal from %s failed while %s: %s\n",
                $rehearsal->destinationName,
                $rehearsal->step,
                $container->get(Translator::class)->trans($rehearsal->errorKey()),
            ));
            exit(1);
        }

        $out(sprintf(
            $rehearsal->kind === 'restore'
                ? 'Rehearsed from %s: downloaded, verified, restored into the scratch database, checked and emptied.'
                : 'Rehearsed from %s: downloaded and verified. Set BACKUP_REHEARSAL_DB_* to restore it as well.',
            $rehearsal->destinationName,
        ));
        exit(0);

    case 'backup:fetch':
        // Phase 39: one stored copy back from a destination, for
        // backup:restore. Its id is in Settings → Instance → Destinations.
        $destinationId = $argv[2] ?? '';
        $object = $argv[3] ?? '';
        $target = $argv[4] ?? basename($object);
        if (!ctype_digit($destinationId) || $object === '' || $target === '') {
            fwrite(STDERR, "Usage: backup:fetch <destination-id> <object> [<file>]\n");
            exit(1);
        }
        if (file_exists($target)) {
            fwrite(STDERR, sprintf("%s already exists. Nothing was downloaded.\n", $target));
            exit(1);
        }

        try {
            $container->get(BackupRehearsalService::class)->fetch((int) $destinationId, $object, $target);
        } catch (DestinationException $exception) {
            fwrite(STDERR, sprintf("Could not fetch it (%s): %s\n", $exception->step, $exception->getMessage()));
            exit(1);
        }

        $out(sprintf(
            'Fetched %s (%s bytes). Restore it with: bin/console backup:restore %s',
            $target,
            number_format((int) filesize($target)),
            $target,
        ));
        exit(0);

    case 'backup:verify':
        // Any instance backup, from this server or not: decrypt it and check
        // every entry against its manifest.
        $file = $argv[2] ?? '';
        if ($file === '' || !is_file($file)) {
            fwrite(STDERR, "Usage: backup:verify <file>\n");
            exit(1);
        }

        try {
            $manifest = $container->get(InstanceBackupService::class)->verifyFile($file);
        } catch (BackupException $exception) {
            fwrite(STDERR, 'FAIL ' . $exception->getMessage() . PHP_EOL);
            exit(1);
        }

        $out(sprintf(
            'OK   %s verifies: %d table(s), %d row(s), %d file(s). Taken %s on %s by Renovo %s,'
            . ' at migration %s.',
            basename($file),
            count($manifest['tables']),
            array_sum($manifest['tables']),
            count($manifest['entries']) - count($manifest['tables']),
            $manifest['created_at'],
            $manifest['engine'],
            $manifest['renovo_version'],
            $manifest['migration_version'],
        ));
        exit(0);

    case 'backup:decrypt':
        // So an operator can open a backup with ordinary tools and the key,
        // without Renovo's database. The output is plaintext: every password
        // hash and invoice. Keep it no longer than it is needed.
        $file = $argv[2] ?? '';
        $destination = $argv[3] ?? '';
        if ($file === '' || $destination === '' || !is_file($file)) {
            fwrite(STDERR, "Usage: backup:decrypt <file> <out.zip>\n");
            exit(1);
        }
        if (file_exists($destination)) {
            fwrite(STDERR, sprintf("%s already exists. Choose a new file name.\n", $destination));
            exit(1);
        }

        try {
            $container->get(InstanceBackupService::class)->decryptFile($file, $destination);
        } catch (BackupException $exception) {
            @unlink($destination);
            fwrite(STDERR, 'FAIL ' . $exception->getMessage() . PHP_EOL);
            exit(1);
        }

        $out(sprintf('Decrypted to %s. It is not encrypted: delete it when you are done.', $destination));
        exit(0);

    case 'backup:restore':
        // Disaster recovery, into an empty database at the backup's migration
        // version. Refuses — changing nothing — otherwise. See docs/operations.md.
        $file = $argv[2] ?? '';
        if ($file === '' || !is_file($file)) {
            fwrite(STDERR, "Usage: backup:restore <file>\n");
            exit(1);
        }

        try {
            $summary = $container->get(InstanceRestoreService::class)->restore($file);
        } catch (BackupException $exception) {
            fwrite(STDERR, $exception->getMessage() . PHP_EOL);
            exit(1);
        }

        $out(sprintf(
            'Restored %d row(s) across %d table(s), and %d file(s), at migration %s.',
            $summary['rows'],
            $summary['tables'],
            $summary['files'],
            $summary['migration_version'],
        ));
        $out('Now run `vendor/bin/phinx migrate` to bring the schema up to this version of Renovo.');
        exit(0);

    case 'demo:seed':
        // Builds the household a read-only demonstration shows. Safe to run
        // twice: it does nothing at all if the demo account already exists.
        $result = $container->get(DemoSeedService::class)->seed();

        if (!$result['created']) {
            $out(sprintf('The demo account (%s) already exists. Nothing was changed.', DemoSeedService::EMAIL));
            exit(0);
        }

        $out(sprintf(
            'Created the demo household: %d subscriptions and %d budgets across %d accounts.',
            $result['subscriptions'],
            $result['budgets'],
            count($result['accounts']),
        ));
        $out('');

        // Both passwords, because the second account is the point of there
        // being two: signing in as the Contributor is the only way to see what
        // a role that reads the whole household and writes only its own part
        // of it actually looks like.
        foreach ($result['accounts'] as $account) {
            $out(sprintf('  %s (%s)', $account['email'], $account['role']));
            $out('  Password: ' . $account['password']);
            $out('');
        }

        $out('This is shown once. Turn on "Read-only demonstration" under Settings → Instance');
        $out('to close the instance to writes.');
        exit(0);

    case 'i18n:check':
        // Every locale against the base, both directions. Runs in CI beside
        // the linters: it needs no database, so a locale that has drifted is
        // reported in seconds rather than after the full suite.
        $reports = $container->get(CatalogChecker::class)->check();

        if ($reports === []) {
            $out(sprintf(
                'Only the base locale (%s) is present. Nothing to compare.',
                Translator::BASE_LOCALE,
            ));
            exit(0);
        }

        $drifted = 0;

        foreach ($reports as $report) {
            if ($report->isComplete()) {
                $out(sprintf('%-8s OK   %d/%d keys', $report->locale, $report->translated(), $report->total));

                continue;
            }

            $drifted++;

            $out(sprintf(
                '%-8s FAIL %d/%d keys, %d missing, %d not in the base catalogue',
                $report->locale,
                $report->translated(),
                $report->total,
                count($report->missing),
                count($report->extra),
            ));

            foreach ($report->missing as $key) {
                $out('           missing: ' . $key);
            }

            foreach ($report->extra as $key) {
                $out('           extra:   ' . $key);
            }
        }

        if ($drifted > 0) {
            fwrite(STDERR, sprintf(
                "\n%d locale(s) differ from the base catalogue translations/%s.php.\n",
                $drifted,
                Translator::BASE_LOCALE,
            ));
            exit(1);
        }

        exit(0);

    case 'assets:offline-check':
        // The offline rule, enforced rather than reviewed: nothing the browser
        // loads may come from a third-party host. Runs in CI after the asset
        // build, because the build's *output* is as much a place a CDN can
        // appear as the templates are — a dependency with a hardcoded font URL
        // in its own @font-face would pass a check that only read our files.
        $references = $container->get(ExternalAssetScanner::class)->scan();

        if ($references === []) {
            $out('OK   No third-party asset host referenced in ' . implode(
                ', ',
                ExternalAssetScanner::DIRECTORIES,
            ) . '.');
            exit(0);
        }

        foreach ($references as $reference) {
            $out('FAIL ' . $reference->describe());
        }

        fwrite(STDERR, sprintf(
            "\n%d external asset reference(s). A self-hosted instance may have no route to a CDN at\n"
            . "all, so every byte the page loads must be served from this instance. Install the\n"
            . "dependency from npm and let the build vendor it, or add the host to\n"
            . "ExternalAssetScanner::ALLOWED_HOSTS if it is an identifier rather than an address.\n",
            count($references),
        ));
        exit(1);

    case 'coverage:check':
        // The floor under the whole suite's line coverage. CI holds each pull
        // request's changed lines to 80% separately (diff-cover); this catches
        // the slow slide that many small, individually passing PRs can add up
        // to. Reads a Clover report the suite has already written.
        $report = $argv[2] ?? 'build/coverage.xml';
        $minimum = isset($argv[3]) ? (int) $argv[3] : CoverageFloor::MINIMUM_PERCENT;

        try {
            $floor = CoverageFloor::fromCloverFile($report);
        } catch (RuntimeException $e) {
            fwrite(STDERR, 'FAIL ' . $e->getMessage() . PHP_EOL);
            exit(1);
        }

        $summary = sprintf(
            '%.2f%% of lines covered (%d/%d); the floor is %d%%.',
            $floor->percent(),
            $floor->covered,
            $floor->statements,
            $minimum,
        );

        if ($floor->meets($minimum)) {
            $out('OK   ' . $summary);
            exit(0);
        }

        fwrite(STDERR, 'FAIL ' . $summary . PHP_EOL);
        exit(1);

    case 'list':
    case '--help':
    case '-h':
        $out('Renovo console');
        $out('');
        $out('Usage: php bin/console <command>');
        $out('');
        $out('  reminders:run        Send due reminders, trial, cancel-by and budget alerts');
        $out('  rates:refresh        Fetch and cache exchange rates from the configured provider');
        $out('  updates:check        Ask GitHub for the latest release now (only when update checks are on)');
        $out('  maintenance:prune    Delete expired sessions, tokens, throttle, notification and audit records');
        $out('  i18n:check           Compare every locale with the base catalogue and report any drift');
        $out('  assets:offline-check Fail if any template or built asset references a third-party host');
        $out('  coverage:check       Fail if a Clover report\'s line coverage is under the floor (default 85%)');
        $out('  ledger:backfill      Rebuild past charges into the payment ledger [--household=ID]');
        $out('  secrets:rotate       Re-encrypt every stored secret under the current key [--dry-run]');
        $out('  backup:run           Take an instance backup if one is due [--force to take one now]');
        $out('  backup:verify        Decrypt an instance backup and check every entry <file>');
        $out('  backup:decrypt       Decrypt an instance backup into a plain ZIP <file> <out.zip>');
        $out('  backup:restore       Restore an instance backup into an empty database <file>');
    $out('  backup:rehearse      Rehearse a restore from a destination if one is due [--force]');
    $out('  backup:fetch         Download a stored copy from a destination <id> <object> [<file>]');
        $out('  demo:seed            Create the demonstration household and its subscriptions');
        exit(0);

    default:
        fwrite(STDERR, sprintf("Unknown command \"%s\". Run `php bin/console list`.\n", $command));
        exit(1);
}
