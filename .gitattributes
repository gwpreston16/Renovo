# Every text file is LF, in the repository and in a checkout, whatever the
# platform's core.autocrlf says. The containers run the shell scripts, PSR-12
# (phpcs) rejects CRLF, and tests match source and CSS text with "\n"; a
# Windows checkout with CRLF failed all three. Git decides what is text.
* text=auto eol=lf

# Windows batch files are the exception: cmd.exe expects CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# The Impeccable launcher is a POSIX sh script; CRLF line endings break it.
.claude/skills/impeccable/scripts/impeccable text eol=lf
